<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        HTTPS everywhere (CAB-48). This covers the app's own requests, not the LAN server it runs (which is TLS). Plain
        HTTP is left only for 127.0.0.1, where the relay tunnel reaches the media server's loopback listener.
        Debug builds override this file (src/debug) for a plain-HTTP development server.
    -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
