<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        HTTPS everywhere (CAB-48), with one exception: a self-hosted server on a home network may use plain HTTP.
        This file can't express private address ranges, so cleartext is permitted here and enforced in code instead:
        every OkHttp client comes from cablegramHttpClient() (data/HttpClients.kt), whose PrivateCleartextOnly
        interceptor rejects plain HTTP to anything but loopback and private-network hosts. The phone's LAN server is
        TLS with a certificate this TV pins (LanTls); LibVLC plays from this TV's own loopback servers.
        Debug builds override this file (src/debug).
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
