<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>Cablegram</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleLocalizations</key>
	<array><string>en</string><string>de</string><string>ar</string><string>fa</string><string>ru</string><string>es</string><string>it</string></array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key><string>app.cablegram.phone</string>
			<key>CFBundleURLSchemes</key><array><string>cablegram</string></array>
		</dict>
		<dict>
			<key>CFBundleURLName</key><string>google-sign-in</string>
			<key>CFBundleURLSchemes</key><array><string>$(GOOGLE_REVERSED_CLIENT_ID)</string></array>
		</dict>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key><false/>
	<key>NSSupportsLiveActivities</key><true/>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key><string>LaunchBackground</string>
	</dict>
	<key>UIUserInterfaceStyle</key><string>Dark</string>
	<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
	<key>NSCameraUsageDescription</key><string>Cablegram uses the camera to scan the pairing code shown on your TV.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- A self-hosted server on a home network may use plain HTTP; everything else stays HTTPS. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key><string>Cablegram finds your TVs on your home network and serves videos to them.</string>
	<key>NSBonjourServices</key>
	<array><string>_cablegram._tcp</string><string>_googlecast._tcp</string><string>_$(CABLEGRAM_CAST_APP_ID)._googlecast._tcp</string></array>
	<key>NSPhotoLibraryUsageDescription</key><string>Cablegram lists the videos in your Photos library so you can play them on your TV.</string>
	<key>GIDClientID</key><string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>CablegramAPIBase</key><string>$(API_BASE)</string>
	<key>CablegramWebAppBase</key><string>$(WEB_APP_BASE)</string>
	<key>CablegramCastAppID</key><string>$(CABLEGRAM_CAST_APP_ID)</string>
	<key>CablegramSubtitleSpeechSync</key><string>$(SUBTITLE_SPEECH_SYNC)</string>
	<key>CablegramLanIdleTimeoutMs</key><string>$(LAN_IDLE_TIMEOUT_MS)</string>
	<key>CablegramLanHostOverride</key><string>$(LAN_HOST_OVERRIDE)</string>
</dict>
</plist>
