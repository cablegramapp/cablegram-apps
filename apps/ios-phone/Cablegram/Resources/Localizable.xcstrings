    "ui_choose_videos_or_add_folders_with_android_s_picker_one_af9bf1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر فيديوهات أو أضف مجلدات باستخدام أداة اختيار الملفات في Android، مجلدًا واحدًا في كل مرة. تبقى المجلدات المختارة متاحة هنا حتى تزيلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Videos oder fügen Sie Ordner mit Android Picker, ein Ordner zu einem Zeitpunkt. Ihre ausgewählten Ordner bleiben hier verfügbar, bis Sie sie entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose videos or add folders with Android's picker, one folder at a time. Your selected folders stay available here until you remove them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige vídeos o añade carpetas con el selector de Android, una carpeta a la vez. Sus carpetas seleccionadas permanecen disponibles aquí hasta que las elimina."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با ابزار انتخاب فایل اندروید، ویدیوها را انتخاب کنید یا پوشه‌ها را یکی‌یکی اضافه کنید. پوشه‌های انتخاب‌شده تا زمانی که حذفشان کنید، در اینجا در دسترس می‌مانند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegliere video o aggiungere cartelle con Android's picker, una cartella alla volta. Le tue cartelle selezionate rimangono disponibili qui finché non le rimuovi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите видео или добавьте папки с набором Android, по одной папке за раз. Ваши избранные папки остаются доступными здесь, пока вы их не удалите."
          }
        }
      }
    },
