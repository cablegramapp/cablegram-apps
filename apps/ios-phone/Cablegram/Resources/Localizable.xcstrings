    "ui_your_phone_number_login_code_and_password_go_straight__bc3e04": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رقم هاتفك، رمز الدخول وكلمة السر تذهب مباشرة إلى Telegram لم يرسلوا أو يخزنوا على خوادم Cablegram"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Telefonnummer, Login-Code und Passwort gehen direkt auf Telegram. Sie werden niemals an Cablegram Server gesendet oder gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone number, login code and password go straight to Telegram. They are never sent to or stored on Cablegram's servers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su número de teléfono, código de inicio de sesión y contraseña va directo a Telegram. Nunca son enviados o almacenados en los servidores de Cablegram."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شمارهٔ تلفن، کد ورود و رمز عبور شما مستقیماً به تلگرام ارسال می‌شوند. این اطلاعات هرگز به سرورهای Cablegram فرستاده یا در آن‌ها ذخیره نمی‌شوند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo numero di telefono, il codice di accesso e la password vanno direttamente a Telegram. Non vengono mai inviati o memorizzati sui server di Cablegram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш номер телефона, код входа и пароль идут прямо к Telegram. Они никогда не отправляются и не хранятся на серверах Cablegram."
          }
        }
      }
    },
    "ui_your_provider_credentials_were_refused_update_them_in__aa1759": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
