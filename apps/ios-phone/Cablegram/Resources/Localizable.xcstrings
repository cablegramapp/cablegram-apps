    "ui_otherwise_it_plays_your_telegram_videos_through_this_p_72fc1d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خلاف ذلك، فإنه يلعب الفيديو الخاص بك Telegram من خلال هذا الهاتف، ويعقد أي دورة Telegram."
          }
        },
        "de": {
          "stringUnit": {
