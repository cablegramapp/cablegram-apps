    "ui_cloudflare_now_shows_an_access_key_id_a_secret_access__5639c8": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare الآن يظهر هوية مفتاح الوصول، مفتاح الوصول السري ونقطة النهاية. السر يظهر مرة واحدة فقط لذا أبقي تلك الصفحة مفتوحة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare zeigt nun eine Access Key ID, einen Secret Access Key und einen Endpoint. Das Geheimnis wird nur einmal gezeigt, so halten Sie diese Seite offen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare now shows an Access Key ID, a Secret Access Key and an Endpoint. The secret is shown only once, so keep that page open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare ahora muestra un Access Key ID, una clave de acceso secreto y un endpoint. El secreto se muestra sólo una vez, así que mantén esa página abierta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اکنون Cloudflare یک شناسهٔ کلید دسترسی (Access Key ID)، کلید محرمانه (Secret Access Key) و نشانی اتصال (Endpoint) نشان می‌دهد. کلید محرمانه فقط یک بار نمایش داده می‌شود؛ این صفحه را باز نگه دارید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare ora mostra un ID chiave di accesso, una chiave di accesso segreta e un endpoint. Il segreto viene mostrato solo una volta, quindi tieni aperta quella pagina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudflare теперь показывает идентификатор ключа доступа, секретный ключ доступа и конечную точку. Секрет отображается только один раз, поэтому держите эту страницу открытой."
          }
        }
      }
    },
