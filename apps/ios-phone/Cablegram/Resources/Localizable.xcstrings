    "telegram_separate_temporary_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدم بعض الخدمات استردادًا للأموال إذا فشل التحقق. قد تنتهي صلاحية هذه الأرقام أو تُعاد إلى مستخدم آخر، مما يعرّض حسابك في Telegram للخطر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dienste bieten eine Erstattung, wenn die Verifizierung fehlschlägt. Diese Nummern können ablaufen oder neu vergeben werden, wodurch Ihr Telegram-Konto gefährdet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some services offer refunds if verification fails. These numbers can expire or be reassigned, putting your Telegram account at risk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos servicios ofrecen reembolsos si falla la verificación. Estos números pueden caducar o reasignarse, poniendo en riesgo tu cuenta de Telegram."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برخی سرویس‌ها در صورت ناموفق بودن تأیید، وجه را بازمی‌گردانند. این شماره‌ها ممکن است منقضی شوند یا به فرد دیگری واگذار شوند و حساب تلگرام شما را در معرض خطر قرار دهند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni servizi offrono rimborsi se la verifica non riesce. Questi numeri possono scadere o essere riassegnati, mettendo a rischio il tuo account Telegram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые сервисы возвращают деньги при неудачном подтверждении. Срок действия таких номеров может истечь, или их могут передать другому человеку, что ставит ваш аккаунт Telegram под угрозу."
          }
        }
      }
    },
