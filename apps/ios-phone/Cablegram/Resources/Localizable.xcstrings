    "ui_add_profiles_on_the_tv_deleting_one_removes_its_progre_22f2f3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف الملفات الشخصية على التلفزيون. حذف ملف شخصي يزيل تقدّم المشاهدة و«قائمتي» الخاصة به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Profile auf dem Fernseher hinzu. Beim Löschen eines Profils werden dessen Wiedergabefortschritt und „Meine Liste“ entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add profiles on the TV. Deleting one removes its progress and My List."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade perfiles en el televisor. Al eliminar uno, se borran su progreso de reproducción y «Mi lista»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پروفایل‌ها را در تلویزیون اضافه کنید. با حذف هر پروفایل، سابقهٔ پیشرفت تماشا و «فهرست من» آن حذف می‌شود."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i profili sulla TV. Eliminando un profilo, vengono rimossi i suoi progressi di visione e «La mia lista»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте профили на телевизоре. При удалении профиля удаляются его прогресс просмотра и «Мой список»."
          }
        }
      }
    },
