      }
    },
    "ui_the_title_stays_visible_on_the_tv_but_your_phone_must__e1e2d8": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل العنوان ظاهرًا على التلفاز، لكن يجب الموافقة من الهاتف على كل تشغيل، لتشغيل واحد في كل مرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Titel bleibt auf dem Fernseher sichtbar, aber jede Wiedergabe muss auf deinem Telefon genehmigt werden – jeweils nur eine Wiedergabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The title stays visible on the TV, but your phone must approve each play — one playback at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El título sigue visible en la TV, pero debes aprobar cada reproducción desde el teléfono, de una en una."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان روی تلویزیون نمایش داده می‌شود، اما هر بار پخش باید از طریق گوشی تأیید شود. هر تأیید فقط برای یک بار پخش است."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il titolo resta visibile sulla TV, ma ogni riproduzione deve essere approvata dal telefono, una alla volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название остаётся видимым на телевизоре, но каждый запуск нужно подтверждать на телефоне — по одному воспроизведению за раз."
          }
        }
      }
    },
    "ui_the_tv_adfd45": {
