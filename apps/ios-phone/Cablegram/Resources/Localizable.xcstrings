        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporäre E-Mail-Adressen können nicht verwendet werden. Verwenden Sie eine E-Mail-Adresse, die Sie behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary email addresses can't be used. Use an email address you keep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden utilizar direcciones temporales de correo electrónico. Usa una dirección de correo electrónico que guardas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "استفاده از ایمیل موقت ممکن نیست. نشانی ایمیلی وارد کنید که به آن دسترسی دائمی دارید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli indirizzi e-mail temporanei non possono essere utilizzati. Usa un indirizzo e-mail che mantieni."
          }
