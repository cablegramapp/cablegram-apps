    "ui_telegram_connected_videos_you_share_into_cablegram_lib_8c4c5d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاتصال بـ Telegram. تظهر على التلفاز الفيديوهات التي تشاركها في قناة «Cablegram library»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram verbunden. Videos, die du in „Cablegram library“ teilst, erscheinen auf deinem Fernseher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram connected. Videos you share into \"Cablegram library\" appear on your TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram conectado. Los vídeos que compartas en «Cablegram library» aparecerán en tu TV."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلگرام متصل شد. ویدیوهایی که به کانال «Cablegram library» می‌فرستید، روی تلویزیون نمایش داده می‌شوند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram connesso. I video che condividi in «Cablegram library» appaiono sulla TV."
