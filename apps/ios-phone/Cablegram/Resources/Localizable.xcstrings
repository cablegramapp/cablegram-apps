    "ui_open_r2_cloudflare_asks_you_to_subscribe_to_r2_once_it_10d8f5": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح R2. يطلب Cloudflare الاشتراك في R2 مرة واحدة؛ البدء مجاني، وقد يُطلب منك إدخال بطاقة دفع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie R2. Cloudflare bittet Sie, R2 einmal zu abonnieren; es ist kostenlos zu starten, und es kann für eine Zahlungskarte fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open R2. Cloudflare asks you to subscribe to R2 once; it is free to start, and it may ask for a payment card."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Open R2. Cloudflare le pide que se suscriba a R2 una vez; es libre de comenzar, y puede pedir una tarjeta de pago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "R2 را باز کنید. Cloudflare یک بار از شما می‌خواهد سرویس R2 را فعال کنید؛ شروع استفاده رایگان است، اما ممکن است اطلاعات کارت پرداخت بخواهد."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprire R2. Cloudflare ti chiede di iscriverti a R2 una volta; è gratuito per iniziare, e può chiedere una carta di pagamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытый R2. Cloudflare просит вас подписаться на R2 один раз; это бесплатно, и он может запросить платежную карту."
          }
        }
      }
    },
