    "ui_pull_to_refresh_your_library_once_so_this_telegram_vid_c06d0f": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لتحديث المكتبة مرة واحدة حتى يمكن ربط فيديو Telegram هذا، ثم حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie, um Ihre Bibliothek einmal aktualisieren, so dass dieses Telegram Video verlinkt werden kann, dann versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pull to refresh your library once so this Telegram video can be linked, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trate de refrescar su biblioteca una vez para que este vídeo Telegram pueda estar conectado, y luego intentarlo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای اتصال این ویدیوی تلگرام، صفحهٔ کتابخانه را یک بار به پایین بکشید تا تازه‌سازی شود؛ سپس دوباره تلاش کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tirare per aggiornare la tua libreria una volta in modo che questo video Telegram possa essere collegato, quindi riprovare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попросите обновить библиотеку один раз, чтобы это видео Telegram было связано, а затем попробуйте снова."
          }
        }
      }
    },
