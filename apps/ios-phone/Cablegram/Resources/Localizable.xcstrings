    "ui_is_signing_in_to_your_telegram_type_your_two_step_veri_999fde": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل %1$@ الدخول إلى Telegram. أدخل كلمة مرور التحقّق بخطوتين. تُشفّر لهذا التلفزيون فقط ولا يستطيع Cablegram قراءتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ meldet sich bei deinem Telegram an. Gib dein Passwort für die zweistufige Bestätigung ein. Es wird nur für diesen Fernseher verschlüsselt; Cablegram kann es nicht lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ is signing in to your Telegram. Type your two-step verification password. It's encrypted for that TV only; Cablegram can't read it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ está iniciando sesión en tu Telegram. Introduce la contraseña de verificación en dos pasos. Se cifra solo para ese televisor; Cablegram no puede leerla."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ در حال ورود به حساب تلگرام شماست. رمز تأیید دومرحله‌ای را وارد کنید. این رمز فقط برای همان تلویزیون رمزگذاری می‌شود و Cablegram نمی‌تواند آن را بخواند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sta accedendo al tuo Telegram. Inserisci la password della verifica in due passaggi. È crittografata solo per quella TV; Cablegram non può leggerla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ входит в ваш Telegram. Введите пароль двухэтапной аутентификации. Он шифруется только для этого телевизора; Cablegram не может его прочитать."
          }
        }
      }
    },
