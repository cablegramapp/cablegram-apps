    "ui_cablegram_will_stop_remembering_access_to_this_folder__425a31": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتوقف Cablegram عن الاحتفاظ بإذن الوصول إلى هذا المجلد. تبقى الفيديوهات المستوردة في المكتبة، لكن قد تحتاج إلى اختيار المجلد مجددًا لتشغيل الفيديوهات التي تعتمد عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram speichert den Zugriff auf diesen Ordner nicht mehr. Importierte Videos bleiben in deiner Bibliothek. Für Videos aus diesem Ordner musst du ihn möglicherweise erneut auswählen, um sie abzuspielen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram will stop remembering access to this folder. Imported videos stay in your library, but videos that rely on this folder may need it selected again to play."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram dejará de conservar el acceso a esta carpeta. Los vídeos importados seguirán en tu biblioteca, pero quizá debas seleccionar de nuevo la carpeta para reproducir los vídeos que dependan de ella."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram دسترسی ذخیره‌شده به این پوشه را حذف می‌کند. ویدیوهای واردشده در کتابخانه می‌مانند، اما برای پخش ویدیوهای وابسته به این پوشه ممکن است لازم باشد آن را دوباره انتخاب کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram non conserverà più l’accesso a questa cartella. I video importati restano nella libreria, ma per riprodurre quelli che dipendono dalla cartella potrebbe essere necessario selezionarla di nuovo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram больше не будет сохранять доступ к этой папке. Импортированные видео останутся в медиатеке, но для воспроизведения видео из этой папки может потребоваться выбрать её заново."
          }
        }
      }
    },
