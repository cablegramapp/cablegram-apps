    "ui_video_and_timing_patterns_stay_on_this_phone_searches__db1095": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنماط الفيديو والتوقيت تبقى على هذا الهاتف. البحث يذهب مباشرة إلى مقدميك باستخدام حصصك الشخصية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Video und Timing-Muster bleiben auf diesem Telefon. Suchen gehen direkt zu Ihren Anbietern mit Ihrer persönlichen Quote."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Video and timing patterns stay on this phone. Searches go directly to your providers using your personal quota."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los patrones de video y sincronización permanecen en este teléfono. Las búsquedas van directamente a sus proveedores usando su cuota personal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویدیو و الگوهای زمان‌بندی روی همین گوشی می‌مانند. جست‌وجوها مستقیماً به سرویس‌های شما فرستاده می‌شوند و از سهمیهٔ شخصی شما استفاده می‌کنند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli video e i tempi rimangono su questo telefono. Le ricerche vanno direttamente ai vostri fornitori utilizzando la vostra quota personale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео и графики остаются на этом телефоне. Поиски идут непосредственно к вашим поставщикам, используя вашу личную квоту."
          }
        }
      }
    },
