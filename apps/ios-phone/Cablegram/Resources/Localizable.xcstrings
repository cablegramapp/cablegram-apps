    "ui_your_detail_edits_are_saved_on_this_phone_review_any_c_251495": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُفظت تعديلات التفاصيل على هذا الهاتف. راجع أي تعديلات متعارضة، أو أعد المزامنة عند الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Änderungen an den Details sind auf diesem Telefon gespeichert. Prüfe widersprüchliche Änderungen oder wiederhole die Synchronisierung, sobald eine Verbindung besteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your detail edits are saved on this phone. Review any conflicting edits, or retry sync when connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios en los datos están guardados en este teléfono. Revisa los cambios en conflicto o reintenta la sincronización cuando tengas conexión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویرایش جزئیات روی این گوشی ذخیره شده است. تغییرات متعارض را بررسی کنید یا پس از اتصال، دوباره همگام‌سازی کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche dei tuoi dettagli vengono salvate su questo telefono. Verificare eventuali modifiche in conflitto, o riprova sincronizzazione quando collegato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши изменения деталей сохраняются на этом телефоне. Просмотрите любые противоречивые правки или повторите синхронизацию при подключении."
          }
        }
      }
    },
