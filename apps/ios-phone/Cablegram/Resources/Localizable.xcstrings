    "ui_enter_the_6_digit_code_we_sent_to_it_expires_in_15_min_89e634": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز 6 أرقام أرسلناه إلى %1$@ تنتهي بعد 15 دقيقة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie den 6-stelligen Code ein, den wir an %1$@ gesendet haben. Es läuft in 15 Minuten ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 6-digit code we sent to %1$@. It expires in 15 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca el código de 6 dígitos que enviamos a %1$@. expira en 15 minutos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد شش‌رقمی ارسال‌شده به %1$@ را وارد کنید. این کد تا ۱۵ دقیقه معتبر است."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice a 6 cifre che abbiamo inviato a %1$@. Scade tra 15 minuti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите 6-значный код, который мы отправили %1$@. Он истекает через 15 минут."
          }
        }
      }
    },
    "ui_enter_the_6_digit_pin_shown_on_the_tv_or_tap_refresh_c_52ae0e": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل رمز PIN المكوّن من ستة أرقام الظاهر على التلفاز، أو اضغط «تحديث الرمز» هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die sechsstellige PIN vom Fernseher ein oder tippe dort auf „Code aktualisieren“."
          }
        },
