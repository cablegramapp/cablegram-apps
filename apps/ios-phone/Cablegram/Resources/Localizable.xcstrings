    "ui_your_tv_can_t_reach_this_phone_on_wi_fi_streaming_thro_8de181": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذر على التلفاز الوصول إلى هذا الهاتف عبر Wi-Fi. يرفع البث عبر خادم Cablegram الوسيط الفيديو باستخدام باقة بيانات الهاتف (نحو 2–3 غيغابايت لكل ساعة من فيديو HD)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fernseher erreicht dieses Telefon nicht über WLAN. Beim Streaming über den Relay-Dienst von Cablegram wird das Video über deine Mobilfunkverbindung hochgeladen (etwa 2–3 GB pro Stunde HD-Video)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TV can't reach this phone on Wi‑Fi. Streaming through the Cablegram relay uploads the video over your mobile data plan (about 2–3 GB per hour of HD video)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu TV no puede conectarse a este teléfono por Wi-Fi. La transmisión mediante el servidor de retransmisión de Cablegram sube el vídeo usando tu tarifa de datos móviles (unos 2–3 GB por hora de vídeo HD)."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلویزیون نمی‌تواند از طریق وای‌فای به این گوشی دسترسی پیدا کند. پخش با سرور واسط Cablegram، ویدیو را از طریق اینترنت همراه شما بارگذاری می‌کند و از حجم بسته مصرف می‌کند؛ حدود ۲ تا ۳ گیگابایت برای هر ساعت ویدیوی HD."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV non riesce a raggiungere questo telefono tramite Wi-Fi. Lo streaming tramite il server di inoltro di Cablegram carica il video usando il tuo piano dati mobile (circa 2–3 GB per ora di video HD)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор не может связаться с этим телефоном по Wi-Fi. При передаче через сервер ретрансляции Cablegram видео загружается с использованием мобильного трафика (около 2–3 ГБ за час HD-видео)."
          }
        }
      }
    },
    "ui_your_tv_f04452": {
