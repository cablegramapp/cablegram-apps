        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی این گوشی آماده است. وقتی تلویزیونی در دسترس دارید، «پخش در تلویزیون» را بزنید."
          }
        },
        "it": {
          "stringUnit": {
