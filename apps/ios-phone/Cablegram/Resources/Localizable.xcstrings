    "ui_what_it_costs_r2_includes_10_gb_free_after_that_cloudf_499770": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التكلفة: يتضمن R2 مساحة مجانية قدرها 10 غيغابايت؛ بعدها يفرض Cloudflare نحو 0.015 دولار لكل غيغابايت شهريًا. التنزيلات مجانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kosten: R2 bietet 10 GB kostenlos. Danach berechnet Cloudflare etwa 0,015 US-Dollar pro GB und Monat. Downloads sind kostenlos."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What it costs: R2 includes 10 GB free; after that Cloudflare charges about $0.015 per GB a month, and downloads are free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que cuesta: R2 incluye 10 GB gratis; después de que Cloudflare cobra alrededor de $0.015 por GB al mes, y las descargas son gratuitas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هزینه: R2 شامل ۱۰ گیگابایت فضای رایگان است. پس از آن، Cloudflare ماهانه حدود ۰٫۰۱۵ دلار برای هر گیگابایت دریافت می‌کند. دانلود رایگان است."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costi: R2 include 10 GB gratuiti; oltre questa soglia Cloudflare addebita circa 0,015 USD per GB al mese. I download sono gratuiti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что это стоит: R2 включает в себя 10 ГБ бесплатно; после этого Cloudflare взимает около 0,015 долларов США за ГБ в месяц, и загрузки бесплатны."
          }
        }
      }
    },
