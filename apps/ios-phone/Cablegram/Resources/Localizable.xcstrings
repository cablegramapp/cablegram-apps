    },
    "ui_it_only_reaches_the_files_cablegram_creates_never_the__2a9187": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يصل إلا إلى الملفات التي ينشئها Cablegram، وليس بقية ملفات Drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff ist auf Dateien beschränkt, die Cablegram erstellt. Andere Dateien in Drive bleiben unzugänglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It only reaches the files Cablegram creates, never the rest of your Drive."
          }
        },
        "es": {
