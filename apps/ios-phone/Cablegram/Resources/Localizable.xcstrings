    "ui_live_on_your_tv_from_what_it_loaded_tap_save_timing_wh_600c3a": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطبّق الآن على التلفزيون · %1$@ مقارنة بالتوقيت المحمّل. اضغط «حفظ التوقيت» عند التوافق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live auf dem Fernseher · %1$@ gegenüber dem geladenen Timing. Tippe auf „Timing speichern“, sobald es passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live on your TV · %1$@ from what it loaded. Tap Save timing when it matches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En directo en tu televisor · %1$@ respecto al tiempo cargado. Pulsa «Guardar sincronización» cuando coincida."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هم‌اکنون روی تلویزیون · %1$@ نسبت به زمان‌بندی بارگذاری‌شده. وقتی هماهنگ شد، «ذخیرهٔ زمان‌بندی» را بزنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In tempo reale sulla TV · %1$@ rispetto alla sincronizzazione caricata. Tocca «Salva sincronizzazione» quando coincide."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения сразу видны на телевизоре · %1$@ относительно загруженного времени. Когда всё совпадёт, нажмите «Сохранить синхронизацию»."
          }
        }
      }
    },
