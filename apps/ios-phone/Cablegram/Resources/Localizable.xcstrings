    "ui_access_wasn_t_granted_on_google_s_screen_tick_the_box__5ed88c": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُمنح الوصول إلى %1$@. في شاشة Google، حدّد «%2$@» ثم اضغط «متابعة»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf %1$@ wurde nicht gewährt. Aktiviere auf der Google-Seite „%2$@“ und tippe auf „Weiter“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ access wasn't granted. On Google's screen, tick the box \"%2$@\", then tap Continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se concedió acceso a %1$@. En la pantalla de Google, marca «%2$@» y pulsa «Continuar»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به %1$@ داده نشد. در صفحهٔ Google، گزینهٔ «%2$@» را تیک بزنید و سپس روی «ادامه» بزنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso a %1$@ non è stato concesso. Nella schermata di Google, seleziona «%2$@» e tocca «Continua»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к %1$@ не предоставлен. На экране Google отметьте «%2$@» и нажмите «Продолжить»."
          }
        }
      }
    },
