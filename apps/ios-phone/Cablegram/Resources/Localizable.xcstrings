    "ui_attaching_uploads_the_selected_subtitle_text_to_cableg_49b856": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند الإرفاق، يُرفع نص الترجمة المختار إلى Cablegram مع هذا الفيديو لتشغيله على أجهزة التلفزيون المقترنة. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Anhängen wird der ausgewählte Untertitel zusammen mit diesem Video zu Cablegram hochgeladen, damit er auf deinen gekoppelten Fernsehern abgespielt werden kann. "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attaching uploads the selected subtitle text to Cablegram with this video for playback on your paired TVs. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al adjuntarlo, el texto del subtítulo se sube a Cablegram con este vídeo para reproducirlo en tus televisores vinculados. "
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با پیوست کردن، متن زیرنویس انتخاب‌شده همراه این ویدیو در Cablegram بارگذاری می‌شود تا در تلویزیون‌های متصل پخش شود. "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo dei sottotitoli scelti viene caricato su Cablegram insieme a questo video, per la riproduzione sulle TV associate. "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранные субтитры загружаются в Cablegram вместе с этим видео для воспроизведения на подключённых телевизорах. "
          }
        }
      }
    },
