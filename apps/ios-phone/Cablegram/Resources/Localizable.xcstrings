    "ui_google_will_show_a_box_beside_tick_it_then_tap_continu_c21e7b": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستعرض Google مربع اختيار بجانب «%1$@». حدّده ثم اضغط «متابعة». بدونه لا يستطيع Cablegram الحفظ في Drive. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Google zeigt ein Kontrollkästchen neben „%1$@“. Aktiviere es und tippe auf „Weiter“. Ohne diese Freigabe kann Cablegram nicht in Drive speichern. "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google will show a box beside \"%1$@\". Tick it, then tap Continue. Without it Cablegram can't save to your Drive. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Google mostrará una casilla junto a «%1$@». Márcala y pulsa «Continuar». Sin ese permiso, Cablegram no puede guardar en tu Drive. "
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Google کنار «%1$@» یک گزینه نشان می‌دهد. آن را تیک بزنید و سپس «ادامه» را بزنید. بدون این اجازه، Cablegram نمی‌تواند فایلی در Drive شما ذخیره کند. "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Google mostrerà una casella accanto a «%1$@». Selezionala e tocca «Continua». Senza questo permesso Cablegram non può salvare nel tuo Drive. "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Google покажет флажок рядом с «%1$@». Отметьте его и нажмите «Продолжить». Без этого разрешения Cablegram не сможет сохранять файлы в Drive. "
          }
        }
      }
    },
