    "ui_android_paused_saving_after_a_long_run_open_cablegram__736bf1": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف Android الحفظ مؤقتًا بعد تشغيل طويل. افتح Cablegram وابدأ الحفظ مجددًا للمتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android hat das Speichern nach längerer Laufzeit pausiert. Öffne Cablegram und starte das Speichern erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Android paused saving after a long run. Open Cablegram and save again to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ha pausado el guardado tras un periodo prolongado. Abre Cablegram y vuelve a guardar para continuar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اندروید پس از مدتی طولانی، ذخیره‌سازی را متوقف کرد. برای ادامه، Cablegram را باز کنید و دوباره ذخیره را بزنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Android ha sospeso il salvataggio dopo un periodo prolungato. Apri Cablegram e avvia di nuovo il salvataggio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Android приостановил длительное сохранение. Откройте Cablegram и запустите сохранение снова."
          }
        }
      }
    },
