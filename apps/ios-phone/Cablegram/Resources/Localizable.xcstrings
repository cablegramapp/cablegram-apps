    "ui_didn_t_answer_open_cablegram_on_the_tv_and_check_setti_5aa87a": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب %1$@. افتح Cablegram على التلفزيون وتحقّق من تسجيل الدخول في «الإعدادات ← Telegram»، "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat nicht geantwortet. Öffne Cablegram auf dem Fernseher und prüfe unter Einstellungen → Telegram, ob er angemeldet ist, "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ didn't answer. Open Cablegram on the TV and check Settings → Telegram shows it signed in, "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no respondió. Abre Cablegram en el televisor y comprueba en Ajustes → Telegram que la sesión está iniciada, "
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ پاسخ نداد. Cablegram را روی تلویزیون باز کنید و در «تنظیمات ← تلگرام» مطمئن شوید که وارد حساب شده است؛ "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non ha risposto. Apri Cablegram sulla TV e verifica in Impostazioni → Telegram che l’accesso sia attivo, "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ не ответил. Откройте Cablegram на телевизоре и убедитесь в разделе Настройки → Telegram, что вход выполнен, "
          }
        }
      }
    },
    "ui_didn_t_confirm_check_the_tv_e508b0": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ لم يؤكد. تحقق من التلفاز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ haben nicht bestätigt. Sehen Sie sich den Fernseher an."
