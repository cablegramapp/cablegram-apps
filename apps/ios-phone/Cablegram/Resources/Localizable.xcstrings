      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النقل المجاني عبر الخادم الوسيط غير متاح هنا: يوفّر هذا الهاتف هذه الخدمة بالفعل لحسابات Cablegram أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kostenloses Relais ist hier nicht verfügbar: Dieses Telefon gibt bereits kostenloses Relais an andere Cablegram Konten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free relay isn't available here: this phone already gives free relay to other Cablegram accounts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El relé gratuito no está disponible aquí: este teléfono ya da relé gratis a otras Cablegram cuentas."
          }
        },
        "fa": {
