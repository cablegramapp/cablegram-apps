    "ui_after_saving_this_title_stays_on_your_phone_free_up_sp_d0fcae": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد الحفظ، يبقى الفيديو على هاتفك. يمكنك إخلاء المساحة لاحقًا إن أردت."
          }
        },
        "de": {
