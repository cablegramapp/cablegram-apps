            "state": "translated",
            "value": "Telegram не подтвердил загрузку. Попробуйте сохранить ещё раз."
          }
        }
      }
    },
    "ui_telegram_didn_t_provide_this_video_check_that_telegram_4bfa84": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يوفّر Telegram هذا الفيديو. تأكد من اتصال Telegram في الإعدادات، ثم حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram hat dieses Video nicht bereitgestellt. Prüfe, ob Telegram in den Einstellungen verbunden ist, und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram didn't provide this video. Check that Telegram is connected in Settings, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram no ha proporcionado este vídeo. Comprueba que esté conectado en Ajustes y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ویدیو از تلگرام دریافت نشد. اتصال تلگرام را در تنظیمات بررسی کنید و دوباره تلاش کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram non ha fornito questo video. Controllare che Telegram è collegato in Impostazioni, quindi riprovare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram не предоставил это видео. Проверьте подключение Telegram в настройках и повторите попытку."
          }
        }
      }
    },
    "ui_telegram_didn_t_start_check_your_connection_and_try_ag_f28228": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram لم يبدأ تحقق من اتصالك وحاول مرة أخرى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram konnte nicht gestartet werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram didn't start. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido iniciar Telegram. Comprueba la conexión y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلگرام راه‌اندازی نشد. اتصال اینترنت را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
