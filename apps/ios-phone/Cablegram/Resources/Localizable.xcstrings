          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mostra anche un codice. Invia la tua password solo se entrambi i codici sono gli stessi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ также показывает код. Отправляйте пароль только в том случае, если оба кода одинаковы."
          }
        }
      }
    },
