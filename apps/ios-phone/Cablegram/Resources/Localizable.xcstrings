    "ui_recommendations_come_from_posts_in_cablegrambothubs_yo_812f39": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأتي التوصيات من منشورات @CablegramBotHubs. الانضمام إلى القناة أو إضافة روبوت أمر اختياري."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Empfehlungen stammen aus Beiträgen von @CablegramBotHubs. Du musst weder beitreten noch einen Bot hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recommendations come from posts in @CablegramBotHubs. You don’t have to join it or add any bot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las recomendaciones proceden de @CablegramBotHubs. No es necesario unirse ni añadir bots."
