    "ui_a_hotel_a_friend_s_or_a_rental_it_is_unpaired_at_the_t_312310": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلفزيون فندق أو منزل صديق أو مسكن مستأجر. يُلغى اقترانه في الوقت الذي تختاره."
