    "ui_not_available_yet_telegram_only_lets_cablegram_end_a_t_cc8d89": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير متاح بعد: لا يسمح Telegram لـ Cablegram بإنهاء جلسة التلفاز إلا بعد مرور 24 ساعة على اتصالك. حتى ذلك الحين، يشغّل التلفاز فيديوهات Telegram عبر هذا الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht verfügbar: Telegram lässt Cablegram eine TV-Session 24 Stunden nach dem Anschluss beenden. Bis dahin spielt dieser TV Telegram Videos über dieses Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available yet: Telegram only lets Cablegram end a TV's session 24 hours after you connected. Until then this TV plays Telegram videos through this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no está disponible: Telegram solo permite a Cablegram cerrar la sesión de una TV cuando han pasado 24 horas desde tu conexión. Hasta entonces, la TV reproduce los vídeos de Telegram a través de este teléfono."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز در دسترس نیست: تلگرام فقط پس از گذشت ۲۴ ساعت از اتصال، به Cablegram اجازه می‌دهد نشست تلویزیون را پایان دهد. تا آن زمان، این تلویزیون ویدیوهای تلگرام را از طریق این گوشی پخش می‌کند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora disponibile: Telegram consente a Cablegram di terminare la sessione di una TV solo dopo 24 ore dalla connessione. Fino ad allora, la TV riproduce i video di Telegram tramite questo telefono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram позволяет только Cablegram завершить сеанс телевизора через 24 часа после подключения. До тех пор этот телевизор воспроизводит Telegram видео через этот телефон."
          }
        }
      }
    },
    "ui_not_checked_yet_it_s_checked_against_your_video_when_y_46908b": {
      "extractionState": "manual",
      "localizations": {
