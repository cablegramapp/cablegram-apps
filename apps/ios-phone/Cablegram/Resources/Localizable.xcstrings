    "ui_save_a_cloud_copy_of_any_title_to_your_own_google_driv_3aac39": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ نسخة سحابية من أي عنوان في Google Drive الخاص بك. يستطيع التلفاز تشغيلها عندما لا يكون الهاتف متاحًا، ويمكنك إخلاء مساحة على الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichere eine Cloud-Kopie eines Titels in deinem Google Drive. Dein Fernseher kann sie auch ohne dein Telefon abspielen, und du kannst Speicherplatz auf dem Telefon freigeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a cloud copy of any title to your own Google Drive. Your TV can play it when your phone isn't around, and you can free up space on the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia en la nube de cualquier título en tu Google Drive. La TV podrá reproducirla aunque no tengas el teléfono cerca, y podrás liberar espacio en él."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از هر ویدیو یک نسخه در Google Drive خود ذخیره کنید. وقتی گوشی در دسترس نیست، تلویزیون می‌تواند آن را پخش کند و می‌توانید فضای گوشی را آزاد کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva una copia cloud di qualsiasi titolo nel tuo Google Drive. La TV può riprodurla anche quando il telefono non è vicino e puoi liberare spazio sul telefono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраните облачную копию любого заголовка на свой собственный Google Drive. Ваш телевизор может воспроизводить его, когда вашего телефона нет рядом, и вы можете освободить место на телефоне."
          }
        }
      }
    },
