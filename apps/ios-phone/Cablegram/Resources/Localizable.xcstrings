        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستبقى أجهزة التلفزيون المسجّلة في حسابك على Telegram متصلة حتى تُنهي جلساتها من Telegram، ضمن الإعدادات ← الأجهزة."
          }
