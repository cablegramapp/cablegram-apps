    },
    "ui_it_replaces_your_saved_subtitle_for_this_copy_you_can__428008": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستبدلُ ترجمتَكَ المحفوظةَ لهذه النسخةِ. يمكنك أن تزيله من تفاصيل الفيديو "
