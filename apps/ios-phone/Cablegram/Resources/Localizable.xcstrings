    "ui_use_your_own_telegram_account_as_cloud_storage_share_v_0d5978": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم حسابك الخاص بـ Telegram كمخزن سحابي نتشارك الفيديو في قناة خاصة ونشاهدهم على تلفازك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie Ihr eigenes Telegram-Konto als Cloud-Speicher. Teilen Sie Videos in einen privaten Kanal und beobachten Sie sie auf Ihrem TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your own Telegram account as cloud storage. Share videos into a private channel and watch them on your TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice su propia cuenta de Telegram como almacenamiento en la nube. Compartir vídeos en un canal privado y verlos en su TV."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از حساب تلگرام خود به‌عنوان فضای ابری استفاده کنید. ویدیوها را به کانال خصوصی بفرستید و روی تلویزیون تماشا کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il tuo account Telegram come cloud storage. Condividi i video in un canale privato e guardali sulla tua TV."
          }
        },
        "ru": {
