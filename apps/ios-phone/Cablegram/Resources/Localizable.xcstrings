    "ui_preview_a_cover_and_details_from_the_catalog_your_curr_c33f98": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاين ملصقًا وتفاصيل من الفهرس. يبقى الملصق والتفاصيل الحالية حتى تختار بدائل لها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau einer Abdeckung und Details aus dem Katalog. Ihre aktuelle Abdeckung und Details bleiben, bis Sie Ersatz wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview a cover and details from the catalog. Your current cover and details stay until you choose replacements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa una cubierta y detalles del catálogo. Su cubierta actual y los detalles se quedan hasta que elija los reemplazos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پوستر و جزئیات کاتالوگ را پیش‌نمایش کنید. پوستر و جزئیات فعلی تا زمانی که جایگزینی انتخاب نکنید حفظ می‌شوند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Anteprima una copertura e dettagli dal catalogo. La tua copertura attuale e i dettagli rimangono fino a quando non si sceglie sostituzioni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительный просмотр обложки и деталей из каталога. Ваша текущая обложка и детали остаются, пока вы не выберете замену."
          }
        }
      }
    },
