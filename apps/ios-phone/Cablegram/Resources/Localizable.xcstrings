      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل مقاطع الفيديو أو أعد توجيهها إلى قناة Telegram الخاصة هذه. ستظهر في مكتبتك في Cablegram."
