    "ui_didn_t_get_it_check_your_spam_or_junk_folder_23f145": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصلك الرمز؟ تحقق من مجلد البريد العشوائي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht angekommen? Sieh in deinem Spam-Ordner nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Didn't get it? Check your spam or junk folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No lo recibió? Revise su carpeta de spam o correo no deseado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد را دریافت نکردید؟ پوشهٔ هرزنامه (Spam) را بررسی کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non l'hai ricevuto? Controlla la cartella spam o posta indesiderata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не пришёл код? Проверьте папку «Спам»."
          }
        }
