    "ui_your_video_couldn_t_be_opened_so_matches_can_t_be_chec_0a5097": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح الفيديو، لذا لا يمكن التحقق من توافق الترجمات مع صوته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Video konnte nicht geöffnet werden. Daher lassen sich die Untertiteltreffer nicht anhand der Tonspur prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your video couldn't be opened, so matches can't be checked against its audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido abrir tu vídeo, por lo que no se pueden comprobar los subtítulos encontrados con su audio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویدیو باز نشد؛ بنابراین نمی‌توان هماهنگی زیرنویس‌ها را با صدای آن بررسی کرد."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire il video, quindi non è possibile verificare i sottotitoli trovati rispetto all’audio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось открыть видео, поэтому найденные субтитры нельзя проверить по звуковой дорожке."
          }
        }
      }
    },
    "ui_your_videos_stay_in_storage_you_own_cablegram_doesn_t__0ccf72": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفيديو الخاص بك يبقى في التخزين الخاص بك. Cablegram لا يقدم الأفلام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Videos bleiben im eigenen Speicher. Cablegram liefert keine Filme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your videos stay in storage you own. Cablegram doesn't provide movies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus vídeos permanecen en el almacenamiento que posee. Cablegram no ofrece películas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویدیوها در فضای ذخیره‌سازی شخصی شما می‌مانند. Cablegram فیلم ارائه نمی‌کند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi video rimangono nella tua memoria. Cablegram non fornisce film."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши видео остаются в вашем хранилище. Cablegram не предоставляет фильмы."
          }
        }
      }
    },
    "ui_your_videos_stay_in_your_own_storage_cablegram_keeps_y_89b144": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفيديو الخاص بك البقاء في تخزين الخاص بك. Cablegram يبقي مكتبتك منظمة وجاهزة لتلفازك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Videos bleiben in Ihrem eigenen Speicher. Cablegram hält Ihre Bibliothek organisiert und bereit für Ihren Fernseher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your videos stay in your own storage. Cablegram keeps your library organized and ready for your TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus vídeos permanecen en su propio almacenamiento. Cablegram mantiene tu biblioteca organizada y lista para tu TV."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویدیوها در فضای ذخیره‌سازی شخصی شما می‌مانند. Cablegram کتابخانه را مرتب و آمادهٔ پخش روی تلویزیون نگه می‌دارد."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi video rimangono nella tua memoria. Cablegram mantiene la vostra biblioteca organizzata e pronta per la vostra TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши видео хранятся в вашем собственном хранилище. Cablegram держит вашу библиотеку организованной и готовой для вашего телевизора."
          }
        }
      }
    },
