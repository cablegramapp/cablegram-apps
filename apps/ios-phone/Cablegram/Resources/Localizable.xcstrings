          }
        }
      }
    },
    "ui_that_code_didn_t_match_check_the_code_on_the_tv_and_tr_630194": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تلك الشفرة لم تتطابق تحقق من الشفرة على التلفاز وحاول مرة أخرى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code passte nicht. Überprüfen Sie den Code im TV und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn't match. Check the code on the TV and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no coincidió. Revise el código en la TV e inténtelo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد مطابقت ندارد. کد روی تلویزیون را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice non corrispondeva. Controllare il codice in TV e riprovare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код не совпадал. Проверьте код на телевизоре и попробуйте еще раз."
          }
        }
      }
    },
    "ui_that_code_expired_or_was_tried_too_often_ask_for_a_new_0aa93e": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الرمز أو تجاوز عدد المحاولات المسموح به. اطلب رمزًا جديدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist abgelaufen oder wurde zu oft ausprobiert. Fordere einen neuen an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code expired or was tried too often. Ask for a new one."
          }
        },
        "es": {
          "stringUnit": {
