        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حتی وقتی این گوشی در دسترس نباشد. هر کسی که پیوند آن را داشته باشد نیز می‌تواند آن را باز کند.\n\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
