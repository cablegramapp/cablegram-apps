    "ui_you_re_no_longer_in_the_channel_you_left_it_or_it_was__46af5b": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت لم تعد في قناة \"%1$@\" (تركته أو تم حذفه)، لذا Cablegram لا يمكن أن ترى فيديوهات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind nicht mehr im \"%1$@\" Kanal (Sie haben es verlassen oder es wurde gelöscht), so Cablegram kann seine Videos nicht sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're no longer in the \"%1$@\" channel (you left it or it was deleted), so Cablegram can't see its videos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no estás en el canal \"%1$@\" (lo dejaste o fue borrado), por lo que Cablegram no puede ver sus videos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دیگر عضو کانال «%1$@» نیستید؛ از آن خارج شده‌اید یا کانال حذف شده است. بنابراین Cablegram به ویدیوهای آن دسترسی ندارد."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sei più nel canale \"%1$@\" (lo hai lasciato o è stato cancellato), quindi Cablegram non riesce a vedere i suoi video."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы больше не находитесь в канале «%1$@» (вы оставили его или он был удален), поэтому Cablegram не может видеть его видео."
          }
        }
      }
    },
    "ui_you_skipped_the_audio_check_so_matches_aren_t_verified_d4b86d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تخطّيت فحص الصوت، لذا لم تُتحقق مطابقة الترجمات. استخدم المعاينة لضبط توقيتها بالاستماع أو المشاهدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Audioprüfung übersprungen. Die Untertiteltreffer sind daher nicht bestätigt. Nutze die Vorschau, um die Untertitel nach Gehör oder Bild abzustimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You skipped the audio check, so matches aren't verified. Use the preview to line the subtitles up by ear or by eye."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has omitido la comprobación del audio, así que los subtítulos encontrados no están verificados. Usa la vista previa para sincronizarlos de oído o visualmente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بررسی صدا را رد کردید؛ بنابراین هماهنگی زیرنویس‌ها تأیید نشده است. با دیدن و شنیدن پیش‌نمایش، زمان‌بندی زیرنویس را تنظیم کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai saltato la verifica dell’audio, quindi i sottotitoli trovati non sono verificati. Usa l’anteprima per sincronizzarli a orecchio o visivamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы пропустили проверку звука, поэтому найденные субтитры не проверены. Используйте предпросмотр, чтобы синхронизировать их на слух или визуально."
          }
        }
      }
    },
