        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After saving, this title stays on your phone. Free up space later if you want."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras guardarlo, el vídeo permanece en tu teléfono. Puedes liberar espacio más adelante."
