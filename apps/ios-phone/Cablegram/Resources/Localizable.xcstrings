    "ui_that_cast_device_isn_t_your_selected_tv_choose_a_paire_45fa19": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز Cast هذا ليس التلفاز المحدد. اختر تلفازًا مقترنًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Cast-Gerät ist nicht Ihr ausgewählter TV. Wähle einen gepaarten TV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That Cast device isn't your selected TV. Choose a paired TV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese dispositivo Cast no es tu televisor seleccionado. Elija una televisión emparejada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دستگاه Cast با تلویزیون انتخابی شما یکسان نیست. یک تلویزیون متصل را انتخاب کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
