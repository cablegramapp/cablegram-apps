    "ui_your_tv_is_already_signed_in_to_your_telegram_it_appro_6e35a3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سُجّل الدخول إلى حسابك في Telegram على التلفاز بالفعل. سيوافق التلفاز على هذا الهاتف، ولن تحتاج إلى رقم هاتفك أو رمز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fernseher ist bereits bei deinem Telegram-Konto angemeldet. Er gibt dieses Telefon frei, sodass du weder Telefonnummer noch Code benötigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TV is already signed in to your Telegram. It approves this phone, so you don't need your phone number or a code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu TV ya ha iniciado sesión en tu cuenta de Telegram. Autorizará este teléfono, así que no necesitas tu número ni un código."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلویزیون شما از قبل وارد حساب تلگرام شده است و ورود این گوشی را تأیید می‌کند؛ بنابراین نیازی به شمارهٔ تلفن یا کد ندارید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV ha già effettuato l’accesso al tuo account Telegram. Autorizzerà questo telefono, quindi non servono il numero di telefono o un codice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На телевизоре уже выполнен вход в ваш аккаунт Telegram. Он подтвердит этот телефон, поэтому номер телефона и код не понадобятся."
          }
        }
      }
    },
    "ui_your_tv_plays_straight_from_telegram_so_your_phone_can_a79536": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشغّل التلفاز الفيديوهات مباشرة من Telegram، لذا يمكن أن يكون هاتفك مغلقًا أو خارج المنزل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Fernseher spielt Videos direkt aus Telegram ab. Dein Telefon kann deshalb ausgeschaltet oder außer Haus sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TV plays straight from Telegram, so your phone can be off or away from home."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu TV reproduce directamente desde Telegram, así que el teléfono puede estar apagado o fuera de casa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلویزیون مستقیماً از تلگرام پخش می‌کند؛ بنابراین گوشی می‌تواند خاموش یا خارج از خانه باشد."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La TV riproduce direttamente da Telegram, quindi il telefono può essere spento o fuori casa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Телевизор воспроизводит видео напрямую из Telegram, поэтому телефон может быть выключен или находиться вне дома."
          }
        }
      }
    },
