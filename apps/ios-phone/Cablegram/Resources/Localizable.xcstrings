          "stringUnit": {
            "state": "translated",
            "value": "even when this phone is away, and anyone given its link can open it.\n\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "aunque este teléfono no esté cerca, y cualquiera que tenga el enlace podrá abrirlo.\n\n"
