    "ui_remove_from_library_keeps_the_file_delete_file_permane_9b57b7": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل من المكتبة يبقي الملف. يحذف الملف بصورة دائمة Cablegramنسخة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen aus der Bibliothek hält die Datei. Löschen Sie die Datei dauerhaft entfernt Cablegrams Kopie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from library keeps the file. Delete file permanently removes Cablegram’s copy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar de la biblioteca mantiene el archivo. Eliminar archivo elimina permanentemente la copia de Cablegram."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«حذف از کتابخانه» فایل را نگه می‌دارد. «حذف دائمی فایل» نسخهٔ ذخیره‌شده در Cablegram را حذف می‌کند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere dalla libreria mantiene il file. Eliminare il file rimuove definitivamente la copia di Cablegram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаление из библиотеки сохраняет файл. Удаление файла навсегда удаляет копию Cablegram."
          }
        }
      }
    },
