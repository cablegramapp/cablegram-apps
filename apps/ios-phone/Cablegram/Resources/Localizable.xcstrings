    },
    "ui_your_session_expired_sign_in_again_to_keep_this_tv_con_46a834": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية جلستك. سجّل الدخول مجددًا لإبقاء التلفاز متصلًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Sitzung ist abgelaufen. Melden Sie sich erneut an, um diesen Fernseher anzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session expired. Sign in again to keep this TV connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su sesión caducó. Inicie sesión de nuevo para mantener conectado este televisor."
          }
