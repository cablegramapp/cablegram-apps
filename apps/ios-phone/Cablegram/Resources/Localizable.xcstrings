    "ui_cablegram_folder_updated_in_telegram_to_include_open_t_515a3b": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُدّث مجلد Cablegram في Telegram. لإضافة %1$@، افتح هذه الروبوتات في Telegram واضغط «بدء»، ثم نظّم المجلد مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Cablegram-Ordner in Telegram wurde aktualisiert. Um %1$@ aufzunehmen, öffne diese Bots in Telegram, tippe auf „Start“ und organisiere den Ordner erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram folder updated in Telegram. To include %1$@, open those bots in Telegram and tap Start, then organize again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha actualizado la carpeta Cablegram en Telegram. Para incluir %1$@, abre esos bots en Telegram, pulsa «Iniciar» y vuelve a organizar la carpeta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پوشهٔ Cablegram در تلگرام به‌روز شد. برای افزودن %1$@، این ربات‌ها را در تلگرام باز کنید و «شروع» را بزنید؛ سپس پوشه را دوباره مرتب کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella Cablegram in Telegram è stata aggiornata. Per includere %1$@, apri questi bot in Telegram, tocca «Avvia» e organizza di nuovo la cartella."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка Cablegram в Telegram обновлена. Чтобы добавить %1$@, откройте этих ботов в Telegram, нажмите «Запустить» и упорядочьте папку снова."
          }
        }
      }
    },
    "ui_cablegram_is_an_unofficial_app_it_isn_t_made_or_endors_7e0562": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram تطبيق غير رسمي لم تطوّره Telegram ولم تعتمدْه. يستخدم حسابك الشخصي عبر واجهة API العامة لـ Telegram."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram ist eine inoffizielle App, die weder von Telegram entwickelt noch unterstützt wird. Sie nutzt dein eigenes Telegram-Konto über die öffentliche Telegram-API."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram is an unofficial app. It isn't made or endorsed by Telegram; it uses your own Telegram account through Telegram's public API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram es una aplicación no oficial, no creada ni respaldada por Telegram. Usa tu propia cuenta mediante la API pública de Telegram."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram یک برنامهٔ غیررسمی است که تلگرام آن را نساخته و تأیید نکرده است. این برنامه از طریق API عمومی تلگرام به حساب خودتان متصل می‌شود."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram è un’app non ufficiale, non creata né approvata da Telegram. Usa il tuo account tramite l’API pubblica di Telegram."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram — неофициальное приложение, не созданное и не одобренное Telegram. Оно использует ваш аккаунт через публичный API Telegram."
          }
        }
      }
    },
