    "telegram_separate_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك ربط حسابك الحالي في Telegram أو إنشاء حساب منفصل لمكتبة Cablegram. الحساب المنفصل اختياري."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können Ihr bestehendes Telegram-Konto verbinden oder ein separates Konto für Ihre Cablegram-Bibliothek erstellen. Ein separates Konto ist optional."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can connect your existing Telegram account or create a separate one for your Cablegram library. A separate account is optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes conectar tu cuenta actual de Telegram o crear otra para tu biblioteca de Cablegram. Usar una cuenta independiente es opcional."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌توانید حساب فعلی تلگرام خود را متصل کنید یا برای کتابخانهٔ Cablegram حساب جداگانه‌ای بسازید. استفاده از حساب جداگانه اختیاری است."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi collegare il tuo account Telegram esistente o crearne uno separato per la libreria Cablegram. Un account separato è facoltativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете подключить существующий аккаунт Telegram или создать отдельный для библиотеки Cablegram. Отдельный аккаунт необязателен."
          }
        }
      }
    },
