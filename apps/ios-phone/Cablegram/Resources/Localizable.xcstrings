    "ui_telegram_signed_cablegram_out_on_this_phone_for_exampl_c6a476": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل Telegram خروج Cablegram على هذا الهاتف (مثلًا من Telegram ← الأجهزة). سجّل الدخول مجددًا أو اقطع الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram hat Cablegram auf diesem Telefon abgemeldet (zum Beispiel über Telegram → Geräte). Melde dich erneut an oder trenne die Verbindung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram signed Cablegram out on this phone (for example from Telegram → Devices). Sign in again, or disconnect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram ha cerrado la sesión de Cablegram en este teléfono (por ejemplo, desde Telegram → Dispositivos). Inicia sesión de nuevo o desconéctalo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلگرام، Cablegram را در این گوشی از حساب خارج کرده است؛ مثلاً از بخش «تلگرام ← دستگاه‌ها». دوباره وارد شوید یا اتصال را قطع کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram ha disconnesso Cablegram su questo telefono (ad esempio da Telegram → Dispositivi). Accedi di nuovo oppure scollegalo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram завершил сеанс Cablegram на этом телефоне (например, через Telegram → Устройства). Войдите снова или отключите подключение."
          }
        }
      }
    },
    "ui_telegram_will_show_a_new_login_alert_possibly_someone__6a8b3b": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيعرض Telegram تنبيهًا بتسجيل دخول جديد، ربما «تمكّن شخص للتو من الوصول إلى رسائلك». هذا هو Cablegram "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram zeigt eine Benachrichtigung über eine neue Anmeldung an, etwa „Jemand hat gerade Zugriff auf deine Nachrichten erhalten“. Das ist Cablegram "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram will show a new-login alert, possibly \"Someone just got access to your messages\". That's Cablegram "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram mostrará una alerta de nuevo inicio de sesión, quizá «Alguien acaba de acceder a tus mensajes». Se trata de Cablegram "
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلگرام هشداری برای ورود جدید نشان می‌دهد؛ ممکن است متن آن «کسی به پیام‌های شما دسترسی پیدا کرد» باشد. این همان Cablegram است "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram mostrerà un avviso di nuovo accesso, forse «Qualcuno ha appena avuto accesso ai tuoi messaggi». È Cablegram "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram покажет уведомление о новом входе, возможно «Кто-то только что получил доступ к вашим сообщениям». Это Cablegram "
          }
        }
      }
    },
    "ui_temporary_email_addresses_can_t_be_used_use_an_email_a_5c8d8f": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "العناوين البريدية المؤقتة لا يمكن استخدامها. استخدم عنوان البريد الإلكتروني الذي تحتفظ به"
