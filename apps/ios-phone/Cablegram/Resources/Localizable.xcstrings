    "ui_connect_your_own_telegram_account_a_private_cablegram__03df9a": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط حسابك في Telegram. تصبح قناة Cablegram الخاصة مساحة تخزين سحابية لفيديوهاتك، باستخدام المساحة المتاحة في حسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie Ihr eigenes Telegram-Konto. Ein privater Cablegram Kanal wird Cloud-Speicher für Ihre Videos, mit dem Raum, der mit Ihrem Konto kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect your own Telegram account. A private Cablegram channel becomes cloud storage for your videos, using the space that comes with your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta tu propia cuenta de Telegram. Un canal privado Cablegram se convierte en almacenamiento en la nube para sus vídeos, utilizando el espacio que viene con su cuenta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب تلگرام خود را متصل کنید. یک کانال خصوصی Cablegram با استفاده از فضای حساب شما، به فضای ابری ویدیوهایتان تبدیل می‌شود."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collegare il proprio account Telegram. Un canale privato Cablegram diventa storage cloud per i tuoi video, utilizzando lo spazio che viene fornito con il tuo account."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите свою учетную запись Telegram Частный канал Cablegram становится облачным хранилищем для ваших видео, используя пространство, которое поставляется с вашей учетной записью."
          }
        }
      }
    },
