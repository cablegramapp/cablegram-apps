        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در غیر این صورت، ویدیوهای تلگرام را از طریق این گوشی پخش می‌کند و نشست تلگرامی روی تلویزیون ایجاد نمی‌شود."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti gioca i tuoi Telegram video attraverso questo telefono, e non contiene Telegram sessione."
