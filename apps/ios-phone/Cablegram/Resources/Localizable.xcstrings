    "delete_account_entry_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحذف حساب Cablegram وبياناته نهائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht dein Cablegram-Konto und seine Daten endgültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently deletes your Cablegram account and its data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente tu cuenta de Cablegram y sus datos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب Cablegram و داده‌های آن را برای همیشه حذف می‌کند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente il tuo account Cablegram e i relativi dati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удаляет ваш аккаунт Cablegram и его данные."
          }
        }
      }
    },
    "delete_account_error_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث شيء خاطئ ولم يحذف حسابك حاول مرة أخرى في لحظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas ging schief und Ihr Konto wurde nicht gelöscht. Versuchen Sie es noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something went wrong and your account was not deleted. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo salió mal y tu cuenta no fue eliminada. Inténtalo de nuevo en un momento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خطایی رخ داد و حساب شما حذف نشد. کمی بعد دوباره تلاش کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa è andato storto e il tuo account non è stato cancellato. Riprova in un momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что-то пошло не так, и ваш аккаунт не был удален. Попробуй еще раз через минуту."
          }
        }
      }
    },
    "delete_account_error_offline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الاتصال بـ Cablegram. لم يُحذف شيء. تحقّق من اتصالك وحاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram ist nicht erreichbar. Es wurde nichts gelöscht. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach Cablegram. Nothing was deleted. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con Cablegram. No se eliminó nada. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال به Cablegram برقرار نشد. چیزی حذف نشده است. اتصال اینترنت را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile connettersi a Cablegram. Non è stato eliminato nulla. Controlla la connessione e riprova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к Cablegram. Ничего не удалено. Проверьте подключение и повторите попытку."
          }
        }
      }
    },
    "delete_account_error_rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكثير من المحاولات لم يحذف شيء. انتظر 15 دقيقة وحاول مرة أخرى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Nichts wurde gelöscht. Warten Sie 15 Minuten und versuchen Sie es wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Nothing was deleted. Wait 15 minutes and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Nada fue borrado. Espera 15 minutos y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد تلاش‌ها بیش از حد مجاز است. چیزی حذف نشده است. ۱۵ دقیقه صبر کنید و دوباره تلاش کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppi tentativi. Niente e' stato cancellato. Attendere 15 minuti e riprovare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком много попыток Ничего не было удалено. Подождите 15 минут и попробуйте еще раз."
          }
        }
      }
    },
    "delete_account_error_session_expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية جلستك. لم يُحذف شيء. سجّل الخروج ثم ادخل مجددًا وأعد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Sitzung ist abgelaufen. Es wurde nichts gelöscht. Melde dich ab und wieder an und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session has expired. Nothing was deleted. Sign out, sign in again, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu sesión ha caducado. No se eliminó nada. Cierra la sesión, vuelve a iniciarla e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشست شما منقضی شده است. چیزی حذف نشده است. از حساب خارج شوید، دوباره وارد شوید و مجدداً تلاش کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione è scaduta. Non è stato eliminato nulla. Esci dall’account, accedi di nuovo e riprova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия сеанса истёк. Ничего не удалено. Выйдите из аккаунта, войдите снова и повторите попытку."
          }
        }
      }
    },
    "delete_account_error_wrong_code": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز ليس صحيحا، أو أنه انتهى. لم يحذف شيء. حاول مرة أخرى، أو إرسال رمز جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code ist nicht richtig, oder er ist abgelaufen. Nichts wurde gelöscht. Versuchen Sie es wieder, oder senden Sie einen neuen Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code is not right, or it expired. Nothing was deleted. Try again, or send a new code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no es correcto, o caducó. Nada fue borrado. Prueba de nuevo, o envía un nuevo código."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد نادرست است یا منقضی شده است. چیزی حذف نشده است. دوباره تلاش کنید یا کد جدیدی بگیرید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice non e' giusto, o e' scaduto. Niente e' stato cancellato. Prova di nuovo, o invia un nuovo codice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот код неправильный, или он истек. Ничего не было удалено. Попробуйте еще раз или отправьте новый код."
          }
        }
      }
    },
    "delete_account_intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف كل شيء دفعة واحدة، ولا يمكن التراجع عن ذلك. لا توجد فترة سماح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermit wird alles auf einmal gelöscht. Das kann nicht rückgängig gemacht werden. Es gibt keine Wartefrist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes everything at once and cannot be undone. There is no grace period."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina todo de una vez y no se puede deshacer. No hay período de gracia."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این کار همه چیز یک‌جا حذف می‌شود و قابل بازگشت نیست. هیچ مهلتی برای لغو وجود ندارد."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i dati verranno eliminati insieme, in modo irreversibile. Non è previsto un periodo di attesa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все данные будут удалены сразу, без возможности восстановления. Периода ожидания нет."
          }
        }
      }
    },
    "delete_account_kept_heading": {
