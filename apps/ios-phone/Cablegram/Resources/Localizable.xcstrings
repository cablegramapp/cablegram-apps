    "ui_single_files_an_app_can_keep_remove_videos_you_no_long_eb70b0": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات الفردية التي يمكن للتطبيق الاحتفاظ بإذن الوصول إليها. أزل الفيديوهات التي لم تعد تحتاجها، أو أضف المجلد الذي يحتوي عليها بدلًا من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "einzelner Dateien, auf die eine App dauerhaft zugreifen kann. Entferne nicht mehr benötigte Videos oder füge stattdessen ihren Ordner hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "single files an app can keep. Remove videos you no longer need, or add their folder instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "archivos individuales a los que una aplicación puede conservar el acceso. Elimina los vídeos que ya no necesites o añade su carpeta en su lugar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل‌های جداگانه را محدود می‌کند. ویدیوهایی را که دیگر نیاز ندارید حذف کنید یا به‌جای فایل‌ها، پوشهٔ آن‌ها را اضافه کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "singoli file a cui un’app può mantenere l’accesso. Rimuovi i video che non ti servono più oppure aggiungi la loro cartella."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "отдельных файлов, доступ к которым может сохранять приложение. Удалите ненужные видео или добавьте их папку."
          }
        }
      }
    },
