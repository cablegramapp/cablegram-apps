    "ui_from_the_channel_in_telegram_and_can_t_be_undone_732b94": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من القناة في Telegram أيضًا، ولا يمكن التراجع عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "auch aus dem Telegram-Kanal. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "from the channel in Telegram, and can't be undone."
          }
        },
        "es": {
