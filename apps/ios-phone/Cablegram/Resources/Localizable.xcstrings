    "ui_nothing_is_hidden_videos_you_remove_from_the_library_a_1d6be6": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء مخبأ الفيديو التي تزيلها من المكتبة تظهر هنا ويمكنك إعادتها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ist verborgen. Videos, die Sie aus der Bibliothek entfernen, erscheinen hier, und Sie können sie wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is hidden. Videos you remove from the library appear here, and you can restore them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada está oculto. Los vídeos que sacas de la biblioteca aparecen aquí, y puedes restaurarlos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویدیوی پنهانی ندارید. ویدیوهایی که از کتابخانه حذف می‌کنید اینجا نمایش داده می‌شوند و می‌توانید آن‌ها را بازیابی کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente e' nascosto. I video che si rimuove dalla libreria appaiono qui, e si può ripristinarli."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не скрыто. Видео, которые вы удаляете из библиотеки, появляются здесь, и вы можете восстановить их."
          }
        }
      }
    },
