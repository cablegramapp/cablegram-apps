    "ui_the_subtitle_file_couldn_t_be_read_choose_it_again_or__f88faf": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف الترجمة لا يمكن قراءته اخترها مرة أخرى أو احتفظ بنسخة على هذا الهاتف"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Untertiteldatei konnte nicht gelesen werden. Wählen Sie es wieder oder speichern Sie eine Kopie auf diesem Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subtitle file couldn't be read. Choose it again or save a copy on this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo subtítulo no podía leerse. Elija de nuevo o guarde una copia en este teléfono."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فایل زیرنویس خوانده نشد. آن را دوباره انتخاب کنید یا نسخه‌ای روی این گوشی ذخیره کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file sottotitolo non poteva essere letto. Scegliere di nuovo o salvare una copia su questo telefono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать файл субтитров. Выберите его снова или сохраните копию на этом телефоне."
          }
        }
      }
    },
    "ui_the_subtitle_sites_see_your_ip_address_the_title_file__cc820e": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تطّلع مواقع الترجمة على عنوان IP والعنوان واسم الملف ومعرّفاته وبصمته الرقمية واللغات المختارة. يبقى الفيديو والصوت وأنماط النشاط على هذا الهاتف. تُحتسب الطلبات والتنزيلات من حصتك الشخصية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Untertitelseiten erhalten deine IP-Adresse, den Titel, Dateinamen, Kennungen, Hashwert und die gewählten Sprachen. Video, Audio und Aktivitätsmuster bleiben auf diesem Telefon. Anfragen und Downloads werden auf dein persönliches Kontingent angerechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subtitle sites see your IP address, the title, file name, identifiers, hash and language choices. Video, audio and activity patterns stay on this phone. Requests and downloads use your personal quota."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los sitios de subtítulos reciben tu dirección IP, el título, el nombre del archivo, sus identificadores, el hash y los idiomas elegidos. El vídeo, el audio y los patrones de actividad permanecen en este teléfono. Las solicitudes y descargas consumen tu cuota personal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سایت‌های زیرنویس، نشانی IP، عنوان اثر، نام فایل، شناسه‌ها، هش و زبان‌های انتخابی شما را می‌بینند. ویدیو، صدا و الگوهای فعالیت روی همین گوشی می‌مانند. درخواست‌ها و دانلودها از سهمیهٔ شخصی شما استفاده می‌کنند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I siti di sottotitoli ricevono il tuo indirizzo IP, il titolo, il nome del file, gli identificatori, l’hash e le lingue scelte. Video, audio e schemi di attività restano su questo telefono. Le richieste e i download consumano la tua quota personale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сайты субтитров получают ваш IP-адрес, название, имя файла, идентификаторы, хеш и выбранные языки. Видео, аудио и данные о характере активности остаются на этом телефоне. Запросы и скачивания расходуют вашу личную квоту."
          }
        }
      }
    },
    "ui_the_terms_just_changed_please_read_them_again_648707": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد تغيرت الشروط للتو رجاءً إقرأها ثانيةً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bedingungen haben sich geändert. Bitte lesen Sie sie erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Terms just changed. Please read them again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los Términos acaban de cambiar. Por favor, léalos de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شرایط استفاده به‌تازگی تغییر کرده است. لطفاً دوباره آن را بخوانید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I Termini sono appena cambiati. Per favore leggili di nuovo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Условия только изменились. Пожалуйста, прочитайте их еще раз."
          }
        }
      }
    },
    "ui_the_terms_or_privacy_policy_just_changed_please_read_t_fa977a": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت شروط الاستخدام أو سياسة الخصوصية. يرجى قراءتها مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzungsbedingungen oder Datenschutzrichtlinien haben sich geändert. Bitte lesen Sie sie erneut."
          }
        },
        "en": {
