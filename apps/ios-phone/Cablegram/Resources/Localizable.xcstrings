    "ui_play_to_a_line_near_the_start_tap_the_line_you_are_hea_1a15b0": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل الفيديو حتى جملة قرب البداية واضغط على الجملة التي تسمعها. كرّر ذلك قرب النهاية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele bis zu einer Dialogzeile nahe dem Anfang und tippe auf die gehörte Zeile. Wiederhole dies nahe dem Ende."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play to a line near the start, tap the line you are hearing, then do the same near the end."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce hasta una frase cerca del inicio y pulsa la línea que escuches. Repite cerca del final."
