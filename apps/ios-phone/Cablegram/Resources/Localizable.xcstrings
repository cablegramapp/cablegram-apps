          }
        }
      }
    },
    "ui_start_it_there_then_use_the_shift_buttons_above_the_su_b40115": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأوا هناك، ثم استخدموا أزرار النوبات فوق العنوان الفرعي يتحرك على التلفاز مباشرةً"
          }
