          "stringUnit": {
            "state": "translated",
            "value": "Enter the 6-digit PIN shown on the TV, or tap Refresh code there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el PIN de 6 dígitos que aparece en la TV o pulsa allí «Actualizar código»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پین شش‌رقمی نمایش‌داده‌شده روی تلویزیون را وارد کنید یا در تلویزیون «تازه‌سازی کد» را بزنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il PIN a 6 cifre mostrato sulla TV oppure tocca «Aggiorna codice» sulla TV."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите шестизначный PIN-код с экрана телевизора или нажмите там «Обновить код»."
          }
        }
      }
    },
