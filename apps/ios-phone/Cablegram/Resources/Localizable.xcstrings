            "state": "translated",
            "value": "Telegram подключён. Видео, которыми вы делитесь в канале «Cablegram library», появляются на телевизоре."
          }
        }
      }
    },
    "ui_telegram_didn_t_confirm_the_upload_try_saving_again_c7e964": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يؤكد Telegram اكتمال الرفع. حاول الحفظ مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram hat den Upload nicht bestätigt. Versuche erneut zu speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram didn't confirm the upload. Try saving again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram no ha confirmado la subida. Intenta guardar de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تلگرام بارگذاری را تأیید نکرد. دوباره ذخیره کنید."
          }
        },
        "it": {
