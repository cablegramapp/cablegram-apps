{
  "sourceLanguage": "en",
  "strings": {
    "account_deleted_message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم حذف حسابك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto wurde gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account was deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su cuenta fue eliminada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب شما حذف شد."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account è stato cancellato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аккаунт был удален."
          }
        }
      }
    },
    "delete_account_cancel": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لغو"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмена"
          }
        }
      }
    },
    "delete_account_code_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم نستطع إرسال الرمز تحقق من اتصالك وحاول مرة أخرى في دقيقة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten den Code nicht senden. Überprüfen Sie Ihre Verbindung und versuchen Sie es wieder in einer Minute."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn't send the code. Check your connection and try again in a minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No podíamos enviar el código. Revise su conexión e intente de nuevo en un minuto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ارسال کد ناموفق بود. اتصال اینترنت را بررسی کنید و یک دقیقهٔ دیگر دوباره تلاش کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non potevamo mandare il codice. Controlla la tua connessione e riprova tra un minuto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы не смогли отправить код. Проверьте свою связь и попробуйте снова через минуту."
          }
        }
      }
    },
    "delete_account_code_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسلنا الرمز إلى %1$@. تنتهي صلاحيته بعد 15 دقيقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben den Code an %1$@ gesendet. Er ist 15 Minuten gültig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We sent it to %1$@. It expires in 15 minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos el código a %1$@. Caduca en 15 minutos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد را به %1$@ فرستادیم. این کد تا ۱۵ دقیقه معتبر است."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo inviato il codice a %1$@. Scade tra 15 minuti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код отправлен на %1$@. Он действителен 15 минут."
          }
        }
      }
    },
    "delete_account_code_label": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز من البريد الإلكتروني"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Code aus der E-Mail"
          }
