    "ui_details_changed_on_another_device_your_edits_are_kept__e208b8": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّرت التفاصيل على جهاز آخر. حُفظت تعديلاتك على هذا الهاتف. راجعها واحفظها مجددًا لاستخدام نسختك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Details auf einem anderen Gerät geändert. Ihre Bearbeitungen werden auf diesem Telefon gespeichert. Überprüfen Sie sie und speichern Sie erneut Ihre Version zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details changed on another device. Your edits are kept on this phone. Review them and save again to use your version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos han cambiado en otro dispositivo. Tus cambios se conservan en este teléfono. Revísalos y vuelve a guardar para usar tu versión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جزئیات در دستگاه دیگری تغییر کرده است. ویرایش‌های شما روی این گوشی محفوظ است. آن‌ها را بررسی کنید و برای استفاده از نسخهٔ خودتان، دوباره ذخیره کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dettagli cambiati su un altro dispositivo. Le tue modifiche sono conservate su questo telefono. Rivedere e salvare di nuovo per utilizzare la tua versione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подробности изменились на другом устройстве. Ваши правки хранятся на этом телефоне. Просмотрите их и сохраните снова, чтобы использовать свою версию."
          }
        }
      }
    },
    "ui_details_saved_on_this_phone_waiting_to_sync_fd7196": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التفاصيل التي تم توفيرها على هذا الهاتف تنتظر مزامنة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
