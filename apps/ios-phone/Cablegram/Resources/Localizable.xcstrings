    "ui_cablegram_only_uses_its_own_private_channel_never_your_dd2890": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Cablegram قناته الخاصة فقط، ولا يقرأ محادثاتك أو جهات اتصالك. يُرسل رقمك ورمز الدخول إلى Telegram فقط."
