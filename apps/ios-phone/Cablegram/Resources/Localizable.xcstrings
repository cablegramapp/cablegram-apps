    "ui_telegram_s_message_says_not_to_give_this_code_to_anyon_7277cb": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنص رسالة Telegram على عدم مشاركة هذا الرمز مع أي شخص. أنت لا تعطيه لشخص: "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram weist darauf hin, diesen Code niemandem zu geben. Du gibst ihn keiner Person: "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram's message says not to give this code to anyone. You're not giving it to a person: "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje de Telegram dice que no le dé este código a nadie. No se lo estás dando a una persona: "
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در پیام تلگرام آمده است که این کد را به کسی ندهید. شما آن را به شخص دیگری نمی‌دهید؛ "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio di Telegram dice di non dare questo codice a nessuno. Non lo stai dando a una persona: "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В сообщении Telegram говорится никому не передавать этот код. Вы не даете его человеку: "
          }
        }
      }
    },
    "ui_telegram_sent_a_login_code_to_your_telegram_app_or_by__0317af": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram أرسل رمز دخول إلى تطبيقك Telegram (أو بواسطة SMS). أدخله هنا"
