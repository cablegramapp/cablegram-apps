    "ui_reconnect_the_original_storage_or_restore_the_file_on__42719e": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعد ربط التخزين الأصلي أو استعد الملف على هاتفك ثم تحقّق مجددًا. يُحفظ العنوان وتقدّم المشاهدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde den ursprünglichen Speicher erneut oder stelle die Datei auf dem Smartphone wieder her. Titel und Wiedergabefortschritt bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect the original storage or restore the file on your phone, then check again. Your title and watch progress are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecta el almacenamiento original o restaura el archivo en el teléfono y comprueba de nuevo. El título y el progreso se conservan."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فضای ذخیره‌سازی اصلی را دوباره متصل کنید یا فایل را به گوشی برگردانید؛ سپس دوباره بررسی کنید. عنوان و سابقهٔ پیشرفت تماشای شما حفظ می‌شود."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricollega l’archiviazione originale o ripristina il file sul telefono, poi verifica di nuovo. Il titolo e i progressi di visione restano salvati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите исходное хранилище или восстановите файл на телефоне и проверьте снова. Название и прогресс просмотра сохраняются."
          }
        }
      }
    },
