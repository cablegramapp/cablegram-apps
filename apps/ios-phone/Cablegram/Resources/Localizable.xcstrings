          "stringUnit": {
            "state": "translated",
            "value": "راه‌اندازی کتابخانهٔ تلگرام بیش از حد طول کشید. اتصال اینترنت را بررسی کنید و دوباره تلاش کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
