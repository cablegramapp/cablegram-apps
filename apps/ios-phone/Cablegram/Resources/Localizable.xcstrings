    "ui_when_your_tv_can_t_reach_this_phone_on_wi_fi_cablegram_b99318": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يتعذر على التلفاز الوصول إلى الهاتف عبر Wi-Fi، يستطيع Cablegram البث عبر خادمه الوسيط. عند استخدام بيانات الهاتف، يُستهلك رصيد باقتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn dein Fernseher dieses Telefon nicht über WLAN erreicht, kann Cablegram über seinen Relay-Dienst streamen. Über Mobilfunk verbraucht das dein Datenvolumen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When your TV can't reach this phone on Wi‑Fi, Cablegram can stream through its relay. On mobile data this uses your data plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando la TV no puede conectarse al teléfono por Wi-Fi, Cablegram puede transmitir a través de su servidor de retransmisión. Si usas datos móviles, consumirá tu tarifa de datos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی تلویزیون نتواند از طریق وای‌فای به این گوشی دسترسی پیدا کند، Cablegram می‌تواند ویدیو را از طریق سرور واسط پخش کند. با اینترنت همراه، این کار از حجم بستهٔ شما مصرف می‌کند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando la TV non riesce a raggiungere il telefono tramite Wi-Fi, Cablegram può trasmettere tramite il proprio server di inoltro. Con i dati mobili, questo consuma il traffico del tuo piano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если телевизор не может связаться с телефоном по Wi-Fi, Cablegram может передавать видео через сервер ретрансляции. При использовании мобильной сети расходуется трафик вашего тарифа."
          }
        }
      }
    },
