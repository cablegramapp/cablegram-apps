    "ui_updating_the_telegram_folder_took_too_long_tap_organiz_34b802": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استغرق تحديث مجلد Telegram وقتًا طويلًا. اضغط «تنظيم مجلد Telegram» للمحاولة مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktualisierung des Telegram-Ordners dauerte zu lange. Tippe auf „Telegram-Ordner organisieren“, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating the Telegram folder took too long. Tap Organize Telegram folder to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización de la carpeta de Telegram ha tardado demasiado. Pulsa «Organizar carpeta de Telegram» para reintentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی پوشهٔ تلگرام بیش از حد طول کشید. برای تلاش دوباره، «مرتب کردن پوشهٔ تلگرام» را بزنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aggiornamento della cartella Telegram ha richiesto troppo tempo. Toccare Organizza cartella Telegram per riprovare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление папки Telegram заняло слишком много времени. Нажмите «Упорядочить папку Telegram», чтобы повторить попытку."
          }
        }
      }
    },
