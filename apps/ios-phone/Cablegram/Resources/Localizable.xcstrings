    "ui_two_letter_code_for_example_en_fa_or_de_this_also_help_2d9123": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز من حرفين، مثل en أو fa أو de. يساعد أيضًا على فك ترميز الملفات القديمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei-Buchstaben-Code, zum Beispiel en, fa oder de. Dies hilft auch, ältere Dateien zu decodieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two-letter code, for example en, fa or de. This also helps decode older files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de dos letras, por ejemplo en, fa o de. Esto también ayuda a decodificar archivos antiguos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد دوحرفی زبان، مثل en، fa یا de. این کد به خواندن درست فایل‌های قدیمی هم کمک می‌کند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice a due lettere, per esempio en, fa o de. Questo aiuta anche a decodificare i file più vecchi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двухбуквенный код, например en, fa или de. Это также помогает декодировать старые файлы."
          }
        }
      }
    },
