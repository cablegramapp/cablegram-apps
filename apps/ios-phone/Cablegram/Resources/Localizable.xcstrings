      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قُطع اتصال التخزين. تبقى الملفات في الحاوية؛ احذف رمز API في Cloudflare لإلغاء الوصول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicher getrennt. Deine Dateien bleiben im Bucket. Lösche das API-Token in Cloudflare, um den Zugriff zu widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
