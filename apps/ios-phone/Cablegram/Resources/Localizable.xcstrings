    "ui_off_a_notification_asks_before_each_tv_signs_in_to_tel_6f98b3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند التعطيل: يظهر إشعار لطلب الموافقة قبل دخول كل تلفزيون إلى Telegram. عند التفعيل: تدخل أجهزة التلفزيون المقترنة دون طلب الموافقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: Vor jeder Telegram-Anmeldung eines Fernsehers wird eine Freigabe angefragt. Ein: Gekoppelte Fernseher melden sich ohne Rückfrage an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off: a notification asks before each TV signs in to Telegram. On: paired TVs sign in without asking."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: se pide autorización antes de que cada televisor inicie sesión en Telegram. Activado: los televisores vinculados acceden sin preguntar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش: پیش از ورود هر تلویزیون به تلگرام، اعلانی برای تأیید نمایش داده می‌شود. روشن: تلویزیون‌های متصل بدون درخواست تأیید وارد می‌شوند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: una notifica chiede il permesso prima dell’accesso di ogni TV a Telegram. Attivato: le TV associate accedono senza chiedere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключено: перед входом телевизора в Telegram приходит запрос разрешения. Включено: подключённые телевизоры входят без запроса."
          }
        }
      }
    },
