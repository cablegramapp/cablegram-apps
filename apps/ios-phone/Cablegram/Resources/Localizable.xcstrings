    "ui_on_the_phone_and_every_tv_and_you_can_restore_it_later_69a576": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على الهاتف وجميع أجهزة التلفاز، ويمكنك استعادته لاحقًا. يؤدي الحذف النهائي أيضًا إلى حذفه "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "auf dem Telefon und allen Fernsehern. Du kannst es später wiederherstellen. „Endgültig löschen“ entfernt es auch "
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "on the phone and every TV, and you can restore it later. Delete permanently also deletes it "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "en el teléfono y en cada TV, y puede restaurarlo más tarde. Eliminar permanentemente también lo elimina "
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی گوشی و تمام تلویزیون‌ها پنهان می‌کند و بعداً می‌توانید آن را بازیابی کنید. «حذف دائمی» ویدیو را "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "sul telefono e su tutte le TV, e potrai ripristinarlo in seguito. «Elimina definitivamente» lo elimina anche "
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "на телефоне и всех телевизорах, и его можно будет восстановить позже. Действие «Удалить навсегда» также удалит его "
          }
        }
      }
    },
    "ui_on_the_r2_page_find_account_details_and_tap_manage_nex_31acb8": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في صفحة R2، ابحث عن Account Details واضغط Manage بجانب API Tokens، ثم Create Account API token."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Suche auf der R2-Seite „Account Details“, tippe neben „API Tokens“ auf „Manage“ und dann auf „Create Account API token“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the R2 page, find Account Details and tap Manage next to API Tokens. Then tap Create Account API token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En la página R2, busca «Account Details», pulsa «Manage» junto a «API Tokens» y luego «Create Account API token»."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در صفحهٔ R2، بخش Account Details را پیدا کنید و کنار API Tokens روی Manage بزنید. سپس Create Account API token را انتخاب کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella pagina R2 cerca «Account Details», tocca «Manage» accanto ad «API Tokens», poi «Create Account API token»."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На странице R2 найдите «Account Details», нажмите «Manage» рядом с «API Tokens», затем «Create Account API token»."
          }
        }
      }
    },
