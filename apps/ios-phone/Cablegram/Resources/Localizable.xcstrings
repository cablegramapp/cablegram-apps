    "ui_wants_to_play_videos_from_your_cablegram_library_chann_84f55e": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يريد %1$@ تشغيل الفيديوهات من قناتك «Cablegram library». سيسجّل الدخول إلى حسابك في Telegram كجهاز مستقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ möchte Videos aus deinem Kanal „Cablegram library“ abspielen. Dafür meldet es sich als eigenes Gerät bei deinem Telegram-Konto an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ wants to play videos from your \"Cablegram library\" channel. It signs in as its own device on your Telegram account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ quiere reproducir vídeos de tu canal «Cablegram library». Iniciará sesión como un dispositivo independiente en tu cuenta de Telegram."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ می‌خواهد ویدیوهای کانال «Cablegram library» شما را پخش کند. برای این کار، به‌عنوان یک دستگاه جداگانه وارد حساب تلگرام شما می‌شود."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vuole riprodurre video dal tuo canale «Cablegram library». Accederà al tuo account Telegram come dispositivo indipendente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ хочет воспроизводить видео из вашего канала «Cablegram library». Он войдёт в ваш аккаунт Telegram как отдельное устройство."
          }
        }
