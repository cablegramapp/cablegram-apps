    "ui_a_message_in_your_library_channel_names_a_tmdb_entry_f_47bc0f": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشير رسالة في قناة مكتبتك إلى إدخال TMDB لهذا الفيديو (%1$@، TMDB %2$@). لن يُجرى البحث حتى تختاره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Nachricht in deinem Bibliothekskanal verweist auf einen TMDB-Eintrag für dieses Video (%1$@, TMDB %2$@). Erst wenn du ihn auswählst, wird er abgerufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A message in your library channel names a TMDB entry for this video (%1$@, TMDB %2$@). Nothing is looked up until you choose it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mensaje de tu canal de biblioteca propone una ficha de TMDB para este vídeo (%1$@, TMDB %2$@). No se consultará hasta que la selecciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیامی در کانال کتابخانهٔ شما، اطلاعاتی از TMDB برای این ویدیو معرفی کرده است (%1$@، TMDB %2$@). تا زمانی که آن را انتخاب نکنید، جست‌وجویی انجام نمی‌شود."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un messaggio nel canale della libreria indica una voce TMDB per questo video (%1$@, TMDB %2$@). Verrà cercata solo se la selezioni."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение в канале медиатеки указывает запись TMDB для этого видео (%1$@, TMDB %2$@). Поиск начнётся только после её выбора."
          }
        }
      }
    },
