            "value": "جفت‌شده می‌ماند و در صورت اتصال کتابخانه Telegram می‌تواند از آن استفاده کند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimane associata e può usare la tua libreria Telegram, se ne colleghi una."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он остаётся в паре и может использовать вашу библиотеку Telegram, если вы её подключите."
          }
        }
      }
    },
    "ui_it_stays_on_the_server_until_you_tap_remove_here_chang_9f0819": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى على الخادم حتى تضغط «إزالة» هنا، أو تغيّر الملصق، أو تجعل الفيديو خاصًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es bleibt auf dem Server, bis Sie tippen Hier entfernen, ändern Sie die Abdeckung, oder machen Sie das Video privat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays on the server until you tap Remove here, change the cover, or make the video private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda en el servidor hasta que toque Quitar aquí, cambiar la cubierta, o hacer el vídeo privado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا زمانی که اینجا «حذف» را بزنید، پوستر را تغییر دهید یا ویدیو را خصوصی کنید، روی سرور باقی می‌ماند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimane sul server fino a quando non si tocca Rimuovi qui, cambiare la copertura, o rendere il video privato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он остается на сервере, пока вы не нажмете «Удалить», не измените обложку или не сделаете видео приватным."
          }
        }
      }
    },
