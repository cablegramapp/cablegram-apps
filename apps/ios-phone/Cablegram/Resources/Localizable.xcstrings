            "state": "translated",
            "value": "también del canal de Telegram y no se puede deshacer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از کانال تلگرام هم حذف می‌کند و این کار قابل بازگشت نیست."
          }
        },
