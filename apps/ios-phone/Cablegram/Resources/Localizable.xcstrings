      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثل أي تطبيق Telegram، كـ Telegram Desktop، يسجّل Cablegram الدخول كجهاز في حسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie andere Telegram-Apps, etwa Telegram Desktop, meldet sich Cablegram als Gerät bei deinem Konto an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Like any Telegram app (Telegram Desktop, for example), Cablegram signs in as a device on your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como otras aplicaciones de Telegram, por ejemplo Telegram Desktop, Cablegram inicia sesión como un dispositivo en tu cuenta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
