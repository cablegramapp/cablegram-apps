    "ui_ready_on_this_phone_use_play_on_tv_when_a_tv_is_nearby_bbcf10": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جاهز على الهاتف. استخدم «تشغيل على التلفزيون» عندما يتوفر تلفزيون قريب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Smartphone bereit. Nutze „Auf TV wiedergeben“, wenn ein Fernseher in der Nähe ist."
          }
        },
        "en": {
