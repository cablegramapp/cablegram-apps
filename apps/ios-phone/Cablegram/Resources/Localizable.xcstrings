    "ui_commands_use_your_household_connection_keep_the_tv_con_b044c4": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاوامر تستخدم اتصالك المنزلي أبقي التلفاز متصلاً بالإنترنت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle verwenden Ihre Haushaltsverbindung. Halten Sie den Fernseher mit dem Internet verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commands use your household connection. Keep the TV connected to the internet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comandos usan la conexión del hogar. Mantenga la TV conectada a Internet."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فرمان‌ها از اتصال گروه خانوادگی شما استفاده می‌کنند. تلویزیون را به اینترنت متصل نگه دارید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I comandi usano la tua connessione domestica. Tenere la TV collegata a internet."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команды используют ваше домашнее соединение. Держите телевизор подключенным к Интернету."
          }
        }
      }
    },
    "ui_confirm_your_email_above_to_use_free_relay_73d5f0": {
