          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد دریافتی در ایمیل"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Codice dall'email"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код из электронной почты"
          }
        }
      }
    },
    "delete_account_confirm_button": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف نهائيًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete forever"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar definitivamente"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف برای همیشه"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить навсегда"
          }
        }
      }
    },
    "delete_account_confirm_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم الآن حذف حسابك ومجموعتك العائلية ومكتبتك وكل ما ذُكر أعلاه. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto, dein Haushalt, deine Mediathek und alles oben Aufgeführte werden jetzt gelöscht. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account, household, library and everything listed above will be deleted now. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta, tu hogar, tu biblioteca y todo lo indicado arriba se eliminarán ahora. Esta acción no se puede deshacer."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب شما، گروه خانوادگی، کتابخانه و همه موارد بالا اکنون حذف می‌شوند. این کار قابل بازگشت نیست."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account, il gruppo familiare, la libreria e tutto quanto elencato sopra verranno eliminati ora. Questa operazione è irreversibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш аккаунт, семейная группа, медиатека и все перечисленные выше данные будут удалены сейчас. Это действие нельзя отменить."
          }
        }
      }
    },
    "delete_account_confirm_title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف حسابك نهائيًا؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto endgültig löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete your account for good?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar tu cuenta definitivamente?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حساب شما برای همیشه حذف شود؟"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare definitivamente il tuo account?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить аккаунт навсегда?"
          }
        }
      }
    },
