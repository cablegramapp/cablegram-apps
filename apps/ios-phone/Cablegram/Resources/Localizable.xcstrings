    "ui_it_signs_in_to_your_telegram_library_and_stays_paired_7153cf": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى مقترنًا ويمكنه استخدام مكتبة Telegram الخاصة بك إذا قمت بربط واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Fernseher bleibt gekoppelt und kann Ihre Telegram-Bibliothek nutzen, wenn Sie eine verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays paired and can use your Telegram library if you connect one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
