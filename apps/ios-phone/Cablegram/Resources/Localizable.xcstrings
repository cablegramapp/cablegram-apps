    "ui_isn_t_responding_open_cablegram_on_it_choose_who_s_wat_f5df22": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستجيب %1$@. افتح Cablegram عليه، واختر من يشاهد، ثم حاول مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ reagiert nicht. Öffnen Sie Cablegram auf ihm, wählen Sie, wer zuschaut, dann versuchen Sie es wieder."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ isn't responding. Open Cablegram on it, choose who's watching, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no responde. Abre Cablegram en él, elige quién está mirando, y luego vuelve a intentarlo."
