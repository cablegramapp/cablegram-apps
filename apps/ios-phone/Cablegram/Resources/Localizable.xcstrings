    "ui_keep_your_videos_available_even_when_your_phone_is_off_b72efb": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ نسخة في مساحة التخزين الخاصة بك لتبقى الفيديوهات متاحة حتى عندما يكون الهاتف مغلقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihre Videos auch verfügbar, wenn Ihr Telefon ausgeschaltet ist, indem Sie eine Kopie auf Ihren eigenen Speicher speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your videos available even when your phone is off by saving a copy to your own storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga sus videos disponibles incluso cuando su teléfono está apagado guardando una copia a su propio almacenamiento."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با ذخیرهٔ یک نسخه در فضای ذخیره‌سازی شخصی، ویدیوهایتان حتی وقتی گوشی خاموش است در دسترس می‌مانند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere i video disponibili anche quando il telefono è spento salvando una copia al proprio storage."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите ваши видео доступными, даже когда ваш телефон выключен, сохраняя копию на вашем собственном хранилище."
          }
        }
      }
    },
    "ui_keep_your_videos_in_storage_you_own_they_go_straight_t_697721": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بفيديوهاتك في مساحة تخزين تملكها. تُرسَل إليها مباشرة من الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihre Videos im eigenen Speicher. Sie gehen direkt von Ihrem Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your videos in storage you own. They go straight there from your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga sus vídeos en el almacenamiento que posee. Van directo desde tu teléfono."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویدیوها را در فضای ذخیره‌سازی شخصی خود نگه دارید. فایل‌ها مستقیماً از گوشی به آنجا فرستاده می‌شوند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva i video in uno spazio di archiviazione di tua proprietà. Vengono inviati direttamente dal telefono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Храните видео в собственном хранилище. Они отправляются туда прямо с телефона."
          }
        }
      }
    },
    "ui_keep_your_videos_in_your_own_cloudflare_r2_storage_the_16689a": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ فيديوهاتك في مساحة Cloudflare R2 الخاصة بك. تُرسَل إليها مباشرة من الهاتف، ويشغّلها التلفاز حتى عندما يكون الهاتف مغلقًا. يستغرق الإعداد نحو 5 دقائق، لمرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihre Videos in Ihrem eigenen Cloudflare R2 Speicher. Sie gehen direkt von Ihrem Telefon, und Ihr TV spielt sie auch, wenn das Telefon ausgeschaltet ist. Etwa 5 Minuten, einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your videos in your own Cloudflare R2 storage. They go straight there from your phone, and your TV plays them even when the phone is off. About 5 minutes, once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga sus vídeos en su propio almacenamiento de Cloudflare R2. Ellos van directamente desde tu teléfono, y tu TV los juega incluso cuando el teléfono está apagado. Unos 5 minutos, una vez."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویدیوها را در فضای Cloudflare R2 خود ذخیره کنید. فایل‌ها مستقیماً از گوشی به آنجا می‌روند و تلویزیون حتی وقتی گوشی خاموش است آن‌ها را پخش می‌کند. راه‌اندازی فقط یک بار و حدود ۵ دقیقه زمان می‌برد."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni i tuoi video nel tuo storage Cloudflare R2. Vanno direttamente dal tuo telefono, e la tua TV li suona anche quando il telefono è spento. Circa 5 minuti, una volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите свои видео в собственном хранилище Cloudflare R2. Они идут прямо с вашего телефона, и ваш телевизор воспроизводит их, даже когда телефон выключен. Около 5 минут, один раз."
          }
        }
      }
    },
