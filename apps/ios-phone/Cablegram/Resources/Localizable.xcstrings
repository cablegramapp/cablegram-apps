    "ui_your_tv_can_play_this_with_sound_fda245": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لتلفازك تشغيل هذا الفيديو مع الصوت. "
          }
        },
        "de": {
