    "ui_keep_your_phone_and_tv_on_the_same_wi_fi_to_stream_fro_e080cd": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ الهاتف والتلفاز على شبكة Wi-Fi نفسها للبث من الهاتف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihr Telefon und TV auf der gleichen Wi-Fi, um vom Telefon zu streamen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your phone and TV on the same Wi-Fi to stream from the phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga su teléfono y TV en el mismo Wi-Fi para transmitir desde el teléfono."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای پخش از گوشی، گوشی و تلویزیون را به یک شبکهٔ وای‌فای متصل نگه دارید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenere il telefono e la TV sullo stesso Wi-Fi per trasmettere dal telefono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите свой телефон и телевизор на одном и том же Wi-Fi для потоковой передачи с телефона."
          }
        }
      }
    },
    "ui_keep_your_phone_and_tv_on_the_same_wi_fi_while_watchin_7a397d": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ الهاتف والتلفاز على شبكة Wi-Fi نفسها أثناء المشاهدة. تبقى ملفات الفيديو على هاتفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie Ihr Telefon und TV auf den gleichen Wi-Fi während des Betrachtens. Ihre Videodateien bleiben auf Ihrem Telefon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your phone and TV on the same Wi-Fi while watching. Your video files stay on your phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenga su teléfono y TV en el mismo Wi-Fi mientras mira. Sus archivos de vídeo permanecen en su teléfono."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام تماشا، گوشی و تلویزیون را به یک شبکهٔ وای‌فای متصل نگه دارید. فایل‌های ویدیویی روی گوشی شما می‌مانند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenere il telefono e la TV sullo stesso Wi-Fi mentre si guarda. I tuoi file video rimangono sul tuo telefono."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Держите телефон и телевизор на одном и том же Wi-Fi во время просмотра. Ваши видеофайлы остаются на вашем телефоне."
          }
        }
      }
    },
