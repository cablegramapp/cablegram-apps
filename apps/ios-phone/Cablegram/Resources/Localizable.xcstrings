    "ui_same_wi_fi_streams_directly_elsewhere_cablegram_can_us_8633be": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم البث مباشرة عبر شبكة Wi-Fi نفسها؛ وعبر الشبكات الأخرى، يمكن لـ Cablegram استخدام الخادم الوسيط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche Wi‑Fi Ströme direkt; andernfalls Cablegram kann das Relais verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Same Wi‑Fi streams directly; elsewhere Cablegram can use the relay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mismo Wi‑Fi corrientes directamente; en otros lugares Cablegram puede usar el relé."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در شبکهٔ وای‌فای مشترک، پخش مستقیم است؛ در شبکه‌های دیگر Cablegram می‌تواند از سرور واسط استفاده کند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stessi flussi Wi‑Fi direttamente; altrove Cablegram può usare il relè."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Те же Wi‑Fi потоков напрямую; в другом месте Cablegram может использовать реле."
          }
        }
      }
    },
