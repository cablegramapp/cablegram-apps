    "ui_start_by_importing_a_few_videos_from_your_phone_you_ca_1fb185": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ باستيراد بعض الفيديوهات من هاتفك. يمكنك فتح هذه الجولة مجددًا من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere zunächst einige Videos von deinem Telefon. Du kannst diese Einführung in den Einstellungen erneut öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start by importing a few videos from your phone. You can open this tour again from Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comience por importar algunos vídeos de su teléfono. Puedes abrir esta gira de nuevo desde Ajustes."
