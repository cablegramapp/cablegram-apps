    "ui_frames_aren_t_available_for_this_video_on_this_phone_y_09701f": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر إطارات لهذا الفيديو على الهاتف. يمكنك الاحتفاظ بالملصق أو البحث في الفهرس."
          }
        },
        "de": {
          "stringUnit": {
