{
  "sourceLanguage": "en",
  "strings": {
    "ios_apple_account_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا البريد الإلكتروني مرتبط بالفعل بحساب Apple آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese E-Mail-Adresse ist bereits mit einem anderen Apple-Konto verknüpft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This email is already linked to another Apple account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este correo ya está vinculado a otra cuenta de Apple."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ایمیل از قبل به حساب Apple دیگری وصل است."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa email è già collegata a un altro account Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот адрес уже связан с другим аккаунтом Apple."
          }
        }
      }
    },
    "ios_apple_email_missing": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تشارك Apple عنوان بريد إلكتروني. اسمح بمشاركة بريدك (أو إخفاء بريدي الإلكتروني) وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat keine E-Mail-Adresse weitergegeben. Erlaube das Teilen deiner E-Mail (oder „E-Mail-Adresse verbergen“) und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple didn't share an email address. Allow sharing your email (or Hide My Email) and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no compartió una dirección de correo. Permite compartir tu correo (u Ocultar mi correo) e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple نشانی ایمیلی به اشتراک نگذاشت. اجازهٔ اشتراک ایمیل (یا «پنهان کردن ایمیل من») را بدهید و دوباره تلاش کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non ha condiviso un indirizzo email. Consenti la condivisione dell'email (o Nascondi la mia email) e riprova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не передал адрес электронной почты. Разрешите передачу почты (или «Скрыть e-mail») и попробуйте снова."
          }
        }
      }
    },
    "ios_apple_email_unverified": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البريد الإلكتروني لحسابك في Apple غير مؤكد. سجّل الدخول برمز عبر البريد الإلكتروني بدلًا من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die E-Mail-Adresse deines Apple-Kontos ist nicht bestätigt. Melde dich stattdessen mit einem E-Mail-Code an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Apple account's email isn't verified. Sign in with an email code instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo de tu cuenta de Apple no está verificado. Inicia sesión con un código por correo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایمیل حساب Apple شما تأیید نشده است. به‌جای آن با کد ایمیل وارد شوید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'email del tuo account Apple non è verificata. Accedi invece con un codice via email."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Адрес почты вашего аккаунта Apple не подтверждён. Войдите с помощью кода из письма."
          }
        }
      }
    },
    "ios_apple_not_configured": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الدخول باستخدام Apple غير متاح على هذا الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Apple ist auf diesem Server nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple isn't available on this server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión con Apple no está disponible en este servidor."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ورود با Apple روی این سرور در دسترس نیست."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso con Apple non è disponibile su questo server."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход через Apple недоступен на этом сервере."
          }
        }
      }
    },
    "ios_apple_sign_in_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينجح تسجيل الدخول باستخدام Apple. حاول مرة أخرى أو استخدم رمزًا عبر البريد الإلكتروني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung mit Apple hat nicht geklappt. Versuche es erneut oder nutze einen E-Mail-Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Apple didn't work. Try again or use an email code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar sesión con Apple. Inténtalo de nuevo o usa un código por correo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ورود با Apple انجام نشد. دوباره تلاش کنید یا از کد ایمیل استفاده کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso con Apple non è riuscito. Riprova o usa un codice via email."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось войти через Apple. Попробуйте ещё раз или используйте код из письма."
          }
        }
      }
    },
    "ios_choose_from_files": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من الملفات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Dateien wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from Files"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir de Archivos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب از فایل‌ها"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli da File"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать из Файлов"
          }
        }
      }
    },
    "ios_choose_from_photos": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر من الصور"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus Fotos wählen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose from Photos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir de Fotos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب از عکس‌ها"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli da Foto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбрать из Фото"
          }
        }
      }
    },
    "ios_limited_photos_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرى Cablegram فقط الفيديوهات التي سمحت بها في الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram sieht nur die Videos, die Sie in Fotos freigegeben haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram can see only the videos you allowed in Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram solo ve los vídeos que permitiste en Fotos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram فقط ویدیوهایی را می‌بیند که در عکس‌ها اجازه داده‌اید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram vede solo i video che hai consentito in Foto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Cablegram видит только те видео, которые вы разрешили в Фото."
          }
        }
      }
    },
    "ios_make_it_a_movie_night": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر فيديوهات من الصور أو الملفات، أو أضف مجلدًا. يعرضها Cablegram في مكانها دون نسخ أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie Videos aus Fotos oder Dateien oder fügen Sie einen Ordner hinzu. Cablegram listet sie dort auf, wo sie liegen, und kopiert nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose videos from Photos or Files, or add a folder. Cablegram lists them where they are and copies nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige vídeos de Fotos o Archivos, o añade una carpeta. Cablegram los lista donde están y no copia nada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویدیوها را از عکس‌ها یا فایل‌ها انتخاب کنید یا پوشه‌ای اضافه کنید. Cablegram آن‌ها را همان‌جا که هستند فهرست می‌کند و چیزی کپی نمی‌کند."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli video da Foto o File, oppure aggiungi una cartella. Cablegram li elenca dove si trovano e non copia nulla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите видео из Фото или Файлов либо добавьте папку. Cablegram показывает их там, где они лежат, и ничего не копирует."
          }
        }
      }
    },
    "ios_photos": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عکس‌ها"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Foto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото"
          }
        }
      }
    },
    "ios_photos_access_off": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الصور متوقف. فعّله لـ Cablegram من الإعدادات لاختيار فيديوهات من الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf Fotos ist aus. Aktivieren Sie ihn in den Einstellungen für Cablegram, um Videos aus Fotos zu wählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos access is off. Turn it on for Cablegram in Settings to choose videos from Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a Fotos está desactivado. Actívalo para Cablegram en Ajustes para elegir vídeos de Fotos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به عکس‌ها خاموش است. برای انتخاب ویدیو از عکس‌ها، آن را در تنظیمات برای Cablegram روشن کنید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a Foto è disattivato. Attivalo per Cablegram in Impostazioni per scegliere video da Foto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к фото выключен. Включите его для Cablegram в настройках, чтобы выбирать видео из фото."
          }
        }
      }
    },
    "ios_select_more_videos": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بمزيد من الفيديوهات"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weitere Videos erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow more videos"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir más vídeos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اجازهٔ ویدیوهای بیشتر"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti altri video"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить больше видео"
          }
        }
      }
    },
    "ios_serving_keep_open": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ Cablegram مفتوحًا أثناء تشغيل التلفزيون لمقاطع الفيديو من هذا الـ iPhone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass Cablegram geöffnet, solange dein Fernseher Videos von diesem iPhone abspielt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Cablegram open while your TV plays videos from this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén Cablegram abierto mientras tu TV reproduce vídeos de este iPhone."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا وقتی تلویزیون ویدیوهای این آیفون را پخش می‌کند، Cablegram را باز نگه دارید."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni Cablegram aperto mentre la TV riproduce video da questo iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не закрывайте Cablegram, пока телевизор воспроизводит видео с этого iPhone."
          }
        }
      }
    },
