# Cloudflare Pages response headers. If you host your own API, add its address to connect-src.
# accounts.google.com/gsi/: Google's sign-in button (spec 007). Google needs the page's origin as referrer, so the
# policy sends only the origin to other sites instead of nothing.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; img-src 'self' https: data:; connect-src 'self' https://api.cablegram.app https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; manifest-src 'self'; worker-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# A new release must reach installed copies on their next open.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# CAB-62: Android checks this file to let the Cablegram app open TV pairing links. Debug signing key for now; add the
# Play App Signing key's SHA-256 fingerprint before release.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: max-age=300

# CAB-62: iOS checks this file (no extension, served as JSON) to let the Cablegram app open TV pairing links. Team ID 3S2K758XUS.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: max-age=300
