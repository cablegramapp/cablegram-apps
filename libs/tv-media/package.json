{
  "name": "tv-media",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Demux MP4/MKV in TypeScript and feed the TV's own decoders through Media Source Extensions",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
